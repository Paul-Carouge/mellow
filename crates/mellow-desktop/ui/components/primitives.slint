import { MellowColor, MellowComponent, MellowRadius, MellowSpace, MellowType } from "../tokens.slint";

export enum PresenceStatus { online, idle, do-not-disturb, offline }

// Status dot with a ring cut out of the surface behind it, like Discord. Shape differs per status
// so it never relies on colour alone (DESIGN.md §7).
export component PresenceDot inherits Rectangle {
    in property <PresenceStatus> status;
    in property <color> ring-color;
    width: MellowComponent.status-size-small + 2 * MellowComponent.status-ring-width;
    height: self.width;
    border-radius: self.width / 2;
    background: ring-color;
    accessible-role: image;
    accessible-label: status == PresenceStatus.online ? "Online"
        : status == PresenceStatus.idle ? "Idle"
        : status == PresenceStatus.do-not-disturb ? "Do not disturb" : "Offline";

    dot := Rectangle {
        width: MellowComponent.status-size-small;
        height: self.width;
        border-radius: self.width / 2;
        background: status == PresenceStatus.online ? MellowComponent.status-online
            : status == PresenceStatus.idle ? MellowComponent.status-idle
            : status == PresenceStatus.do-not-disturb ? MellowComponent.status-dnd
            : MellowComponent.status-offline;
        // Idle: crescent (ring-coloured bite). Do not disturb: bar. Offline: hollow ring.
        if status == PresenceStatus.idle: Rectangle {
            x: -parent.width * 0.15;
            y: -parent.height * 0.15;
            width: parent.width * 0.65;
            height: self.width;
            border-radius: self.width / 2;
            background: ring-color;
        }
        if status == PresenceStatus.do-not-disturb: Rectangle {
            width: parent.width * 0.6;
            height: parent.height * 0.25;
            border-radius: self.height / 2;
            background: ring-color;
        }
        if status == PresenceStatus.offline: Rectangle {
            width: parent.width * 0.4;
            height: self.width;
            border-radius: self.width / 2;
            background: ring-color;
        }
    }
}

// shortcut: initials on the accent colour until avatar images exist (M2 attachments).
export component Avatar inherits Rectangle {
    in property <string> initial;
    in property <length> size;
    in property <bool> has-presence: false;
    in property <PresenceStatus> status;
    in property <color> ring-color;
    width: size;
    height: size;
    accessible-role: none;

    Rectangle {
        border-radius: self.width / 2;
        background: MellowColor.accent-fill;
        Text {
            text: initial;
            color: MellowColor.text-on-accent;
            font-size: size * 0.4;
            font-weight: MellowType.message-author.font-weight;
        }
    }
    // The dot overhangs the avatar by 2 px, its ring cut out of the surface behind.
    if has-presence: PresenceDot {
        x: parent.width - self.width + MellowSpace.space-3xs;
        y: parent.height - self.height + MellowSpace.space-3xs;
        status: status;
        ring-color: ring-color;
    }
}

// Red count badge, as on Discord rails and channel rows.
export component MentionBadge inherits Rectangle {
    in property <int> count;
    height: MellowComponent.badge-height;
    // Explicit width: outside a layout a Rectangle would otherwise take its parent's width.
    width: max(MellowComponent.badge-min-width, count-label.preferred-width + 2 * MellowComponent.badge-padding-inline);
    border-radius: MellowComponent.badge-radius;
    background: MellowComponent.badge-background;
    accessible-role: text;
    accessible-label: count + (count == 1 ? " mention" : " mentions");
    HorizontalLayout {
        padding-left: MellowComponent.badge-padding-inline;
        padding-right: MellowComponent.badge-padding-inline;
        count-label := Text {
            text: count > 99 ? "99+" : count;
            color: MellowComponent.badge-text;
            font-size: MellowType.badge.font-size;
            font-weight: MellowType.badge.font-weight;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
}

// Icon-sized square button with hover fill, used in the user panel and headers.
export component IconButton inherits Rectangle {
    in property <image> icon;
    in property <string> label;
    in property <length> size;
    // Phosphor icons are drawn on a 256 grid; at 62.5 % of the button they match Discord's 20-in-32.
    in property <length> icon-size: size * 0.625;
    // Turns the glyph, e.g. a caret pointing back.
    in property <angle> icon-rotation: 0deg;
    in property <color> icon-color;
    in property <color> hover-icon-color: icon-color;
    in property <color> hover-background;
    // Whether Shift was held for the latest activation (click or key), read in `clicked` handlers:
    // Shift+click on Delete skips the confirmation, as on Discord.
    out property <bool> is-shift-held-on-activation;
    // Disabled buttons stay focusable and dim their icon, like Button.
    in property <bool> is-enabled: true;
    out property <bool> has-keyboard-focus: focus-scope.has-focus;
    callback clicked();
    width: size;
    height: size;
    forward-focus: focus-scope;
    border-radius: MellowRadius.sm;
    out property <bool> is-highlighted: (touch.has-hover && is-enabled) || focus-scope.has-focus;
    background: is-highlighted ? hover-background : transparent;
    accessible-role: button;
    accessible-label: label;
    accessible-enabled: is-enabled;
    // Screen readers activate without a pointer event: a Shift left over from an earlier click
    // must not skip a confirmation.
    accessible-action-default => {
        root.is-shift-held-on-activation = false;
        root.activate();
    }

    function activate() {
        if is-enabled {
            root.clicked();
        }
    }

    focus-scope := FocusScope {
        key-pressed(event) => {
            if event.text == " " || event.text == "\n" {
                root.is-shift-held-on-activation = event.modifiers.shift;
                root.activate();
                return accept;
            }
            reject
        }
    }
    touch := TouchArea {
        pointer-event(event) => { root.is-shift-held-on-activation = event.modifiers.shift; }
        clicked => { root.activate(); }
    }
    Image {
        source: icon;
        colorize: is-highlighted ? hover-icon-color : icon-color;
        opacity: is-enabled ? 1 : MellowComponent.button-disabled-opacity;
        width: root.icon-size;
        height: self.width;
        transform-rotation: root.icon-rotation;
        accessible-role: none;
    }
    if focus-scope.has-focus: Rectangle {
        border-width: MellowComponent.focus-ring-width;
        border-color: MellowComponent.focus-ring-color;
        border-radius: parent.border-radius;
    }
}

// One context menu item (DESIGN.md §6.33). Hover fills it as on Discord; keyboard focus adds the
// focus ring, drawn outside the item so it stays visible on the danger fill.
export component ContextMenuItem inherits Rectangle {
    in property <string> label;
    in property <bool> is-danger: false;
    // Accent-coloured label at rest, as Discord's "Invite people"; hover fills it like any item.
    in property <bool> is-accent: false;
    // Optional trailing icon, as in Discord's server menu; decorative.
    in property <image> icon;
    callback activated();
    height: MellowComponent.context-menu-item-height;
    border-radius: MellowComponent.context-menu-item-radius;
    background: !touch.has-hover ? transparent
        : is-danger ? MellowComponent.context-menu-danger-background-focus : MellowComponent.context-menu-item-background-focus;
    accessible-role: button;
    accessible-label: label;
    accessible-action-default => { root.activated(); }
    forward-focus: focus-scope;

    focus-scope := FocusScope {
        key-pressed(event) => {
            if event.text == " " || event.text == "\n" {
                root.activated();
                return accept;
            }
            reject
        }
    }
    touch := TouchArea { clicked => { root.activated(); } }
    property <bool> has-icon: icon.width > 0;
    property <color> content-color: is-danger
        ? (touch.has-hover ? MellowComponent.context-menu-danger-text-focus : MellowComponent.context-menu-danger-text)
        : touch.has-hover ? MellowComponent.context-menu-item-text-focus
        : is-accent ? MellowComponent.context-menu-accent-text : MellowComponent.context-menu-item-text;
    Text {
        x: MellowComponent.context-menu-item-padding-inline;
        width: parent.width - 2 * MellowComponent.context-menu-item-padding-inline
            - (root.has-icon ? MellowComponent.context-menu-item-icon-size + MellowComponent.context-menu-item-padding-inline : 0px);
        text: label;
        color: root.content-color;
        font-size: MellowType.menu-item.font-size;
        font-weight: MellowType.menu-item.font-weight;
        vertical-alignment: center;
        overflow: elide;
        accessible-role: none;
    }
    if root.has-icon: Image {
        x: parent.width - MellowComponent.context-menu-item-padding-inline - self.width;
        source: root.icon;
        colorize: root.content-color;
        width: MellowComponent.context-menu-item-icon-size;
        height: self.width;
        accessible-role: none;
    }
    if focus-scope.has-focus: Rectangle {
        x: -MellowComponent.focus-ring-offset;
        y: -MellowComponent.focus-ring-offset;
        width: parent.width + 2 * MellowComponent.focus-ring-offset;
        height: parent.height + 2 * MellowComponent.focus-ring-offset;
        border-width: MellowComponent.focus-ring-width;
        border-color: MellowComponent.focus-ring-color;
        border-radius: parent.border-radius + MellowComponent.focus-ring-offset;
    }
}

// Button (DESIGN.md §6.1): Secondary by default, Danger for the destructive action, Primary for a
// page's main action.
// shortcut: the login screen keeps its own Primary button (busy label, large size) until a third use.
export component Button inherits Rectangle {
    in property <string> label;
    in property <bool> is-danger: false;
    in property <bool> is-primary: false;
    // Disabled buttons stay focusable, so focus is not lost while an action runs (DESIGN.md §6.1).
    in property <bool> is-enabled: true;
    out property <bool> has-keyboard-focus: focus-scope.has-focus;
    callback clicked();
    height: MellowComponent.button-height;
    min-width: label-text.preferred-width + 2 * MellowComponent.button-padding-inline;
    border-radius: MellowComponent.button-radius;
    property <bool> is-hovered: touch.has-hover && is-enabled;
    // Dims the fill and label, not the focus ring, which must keep its contrast.
    property <float> content-opacity: is-enabled ? 1 : MellowComponent.button-disabled-opacity;
    background: (is-danger
        ? (is-hovered ? MellowComponent.button-danger-background-hover : MellowComponent.button-danger-background)
        : is-primary
        ? (touch.pressed && is-enabled ? MellowComponent.button-primary-background-pressed
            : is-hovered ? MellowComponent.button-primary-background-hover : MellowComponent.button-primary-background)
        : (is-hovered ? MellowComponent.button-secondary-background-hover : MellowComponent.button-secondary-background))
        .with-alpha(content-opacity);
    accessible-role: button;
    accessible-label: label;
    accessible-enabled: is-enabled;
    accessible-action-default => { activate(); }
    forward-focus: focus-scope;

    function activate() {
        if is-enabled {
            root.clicked();
        }
    }

    focus-scope := FocusScope {
        key-pressed(event) => {
            if event.text == " " || event.text == "\n" {
                root.activate();
                return accept;
            }
            reject
        }
    }
    touch := TouchArea {
        mouse-cursor: is-enabled ? MouseCursor.pointer : MouseCursor.default;
        clicked => { root.activate(); }
    }
    label-text := Text {
        text: label;
        color: is-danger ? MellowComponent.button-danger-text
            : is-primary ? MellowComponent.button-primary-text : MellowComponent.button-secondary-text;
        opacity: root.content-opacity;
        font-size: MellowType.button.font-size;
        font-weight: MellowType.button.font-weight;
        accessible-role: none;
    }
    // Outset ring with a gap, so it stays visible against the red and grey fills.
    if focus-scope.has-focus: Rectangle {
        x: -(MellowComponent.focus-ring-offset + MellowComponent.focus-ring-width);
        y: self.x;
        width: parent.width - 2 * self.x;
        height: parent.height - 2 * self.y;
        border-width: MellowComponent.focus-ring-width;
        border-color: MellowComponent.focus-ring-color;
        border-radius: MellowComponent.button-radius - self.x;
    }
}

// Outlined form field with its label above it (DESIGN.md §6.3).
export component TextField inherits Rectangle {
    // Sentence case: what screen readers announce.
    in property <string> label;
    in property <string> placeholder;
    in property <string> helper;
    in property <bool> is-password;
    in property <bool> wants-focus;
    // Bumped by the screen to move focus again, e.g. to the emptied password after an error.
    in property <int> focus-request;
    in-out property <string> text;
    // Shown dimmed and not editable, e.g. a role the person cannot rename; the reason is shown nearby.
    in property <bool> is-read-only;
    // Not editable but at full contrast and selectable: a value to copy, such as an invite code.
    in property <bool> is-value-to-copy;
    // Optional decorative glyph before the text, such as `#` before a channel name.
    in property <image> leading-icon;
    out property <bool> has-keyboard-focus: input.has-focus;
    callback accepted();
    // After each change typed by the person (not after `text` is set from outside).
    callback edited();

    property <bool> is-password-revealed;
    property <bool> has-leading-icon: leading-icon.width > 0;

    forward-focus: input;

    // Fields are created per mode, so this also runs when the card switches to the other mode.
    init => {
        if wants-focus {
            input.focus();
        }
    }
    changed focus-request => {
        if wants-focus {
            input.focus();
        }
    }

    VerticalLayout {
        spacing: MellowComponent.text-field-label-gap;
        Text {
            text: root.label;
            color: MellowComponent.text-field-label-text;
            font-size: MellowType.category.font-size;
            font-weight: MellowType.category.font-weight;
            letter-spacing: MellowType.category.letter-spacing;
            accessible-role: none;
        }
        Rectangle {
            opacity: root.is-read-only ? MellowComponent.button-disabled-opacity : 1;
            height: MellowComponent.text-field-height;
            border-radius: MellowComponent.text-field-radius;
            background: MellowComponent.text-field-background;
            border-width: input.has-focus ? MellowComponent.focus-ring-width : MellowComponent.text-field-border-width;
            border-color: input.has-focus ? MellowComponent.focus-ring-color : MellowComponent.text-field-border;

            // The whole outlined box is the target, not only the line of text inside it.
            TouchArea {
                mouse-cursor: MouseCursor.text;
                clicked => { input.focus(); }
            }
            HorizontalLayout {
                padding-left: MellowComponent.text-field-padding-inline;
                padding-right: root.is-password ? 0px : MellowComponent.text-field-padding-inline;
                spacing: root.has-leading-icon ? MellowSpace.xs : 0px;
                if root.has-leading-icon: VerticalLayout {
                    alignment: center;
                    Image {
                        source: root.leading-icon;
                        colorize: MellowComponent.text-field-icon;
                        width: MellowComponent.text-field-icon-size;
                        height: self.width;
                        accessible-role: none;
                    }
                }
                Rectangle {
                    horizontal-stretch: 1;
                    if input.text == "": Text {
                        x: 0;
                        text: root.placeholder;
                        color: MellowComponent.text-field-placeholder;
                        font-size: MellowType.body-lg.font-size;
                        vertical-alignment: center;
                        accessible-role: none;
                    }
                    input := TextInput {
                        text <=> root.text;
                        single-line: true;
                        read-only: root.is-read-only || root.is-value-to-copy;
                        edited => { root.edited(); }
                        input-type: root.is-password && !root.is-password-revealed ? InputType.password : InputType.text;
                        color: MellowComponent.text-field-text;
                        font-size: MellowType.body-lg.font-size;
                        vertical-alignment: center;
                        accessible-label: root.label;
                        accessible-description: root.helper;
                        accessible-placeholder-text: root.placeholder;
                        accepted => { root.accepted(); }
                    }
                }
                if root.is-password: reveal := Rectangle {
                    // Square, full field height, so the toggle meets the 44 px target.
                    width: MellowComponent.text-field-height;
                    accessible-role: button;
                    accessible-label: "Show password";
                    accessible-checkable: true;
                    accessible-checked: root.is-password-revealed;
                    accessible-action-default => { root.is-password-revealed = !root.is-password-revealed; }

                    reveal-focus := FocusScope {
                        key-pressed(event) => {
                            if event.text == " " || event.text == "\n" {
                                root.is-password-revealed = !root.is-password-revealed;
                                return accept;
                            }
                            reject
                        }
                    }
                    reveal-touch := TouchArea {
                        clicked => { root.is-password-revealed = !root.is-password-revealed; }
                    }
                    Image {
                        // The icon shows the state the click leads to, as most password fields do.
                        source: root.is-password-revealed ? @image-url("../../icons/eye-slash.svg") : @image-url("../../icons/eye.svg");
                        colorize: reveal-touch.has-hover || reveal-focus.has-focus ? MellowComponent.text-field-icon-hover : MellowComponent.text-field-icon;
                        width: MellowComponent.text-field-icon-size;
                        height: self.width;
                        accessible-role: none;
                    }
                    if reveal-focus.has-focus: Rectangle {
                        border-width: MellowComponent.focus-ring-width;
                        border-color: MellowComponent.focus-ring-color;
                        border-radius: MellowComponent.text-field-radius;
                    }
                }
            }
        }
        if root.helper != "": VerticalLayout {
            padding-top: MellowComponent.text-field-helper-gap - MellowComponent.text-field-label-gap;
            Text {
                text: root.helper;
                color: MellowComponent.text-field-helper-text;
                font-size: MellowType.body-sm.font-size;
                wrap: word-wrap;
                // Already announced as the field's description.
                accessible-role: none;
            }
        }
    }
}
