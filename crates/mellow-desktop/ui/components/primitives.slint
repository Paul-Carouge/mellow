import { MellowColor, MellowComponent, MellowRadius, MellowType } from "../tokens.slint";

export enum PresenceStatus { online, idle, do-not-disturb, offline }

// Status dot with a ring cut out of the surface behind it, like Discord. Shape differs per status
// so it never relies on colour alone (DESIGN.md §7).
export component PresenceDot inherits Rectangle {
    in property <PresenceStatus> status;
    in property <color> ring-color;
    width: MellowComponent.status-size-small + 2 * MellowComponent.status-ring-width;
    height: self.width;
    border-radius: self.width / 2;
    background: ring-color;
    accessible-role: image;
    accessible-label: status == PresenceStatus.online ? "Online"
        : status == PresenceStatus.idle ? "Idle"
        : status == PresenceStatus.do-not-disturb ? "Do not disturb" : "Offline";

    dot := Rectangle {
        width: MellowComponent.status-size-small;
        height: self.width;
        border-radius: self.width / 2;
        background: status == PresenceStatus.online ? MellowComponent.status-online
            : status == PresenceStatus.idle ? MellowComponent.status-idle
            : status == PresenceStatus.do-not-disturb ? MellowComponent.status-dnd
            : MellowComponent.status-offline;
        // Idle: crescent (ring-coloured bite). Do not disturb: bar. Offline: hollow ring.
        if status == PresenceStatus.idle: Rectangle {
            x: -parent.width * 0.15;
            y: -parent.height * 0.15;
            width: parent.width * 0.65;
            height: self.width;
            border-radius: self.width / 2;
            background: ring-color;
        }
        if status == PresenceStatus.do-not-disturb: Rectangle {
            width: parent.width * 0.6;
            height: parent.height * 0.25;
            border-radius: self.height / 2;
            background: ring-color;
        }
        if status == PresenceStatus.offline: Rectangle {
            width: parent.width * 0.4;
            height: self.width;
            border-radius: self.width / 2;
            background: ring-color;
        }
    }
}

// shortcut: initials on the accent colour until avatar images exist (M2 attachments).
export component Avatar inherits Rectangle {
    in property <string> initial;
    in property <length> size;
    in property <bool> has-presence: false;
    in property <PresenceStatus> status;
    in property <color> ring-color;
    width: size;
    height: size;
    accessible-role: none;

    Rectangle {
        border-radius: self.width / 2;
        background: MellowColor.accent-fill;
        Text {
            text: initial;
            color: MellowColor.text-on-accent;
            font-size: size * 0.4;
            font-weight: MellowType.message-author.font-weight;
        }
    }
    if has-presence: PresenceDot {
        x: parent.width - self.width + MellowComponent.status-ring-width;
        y: parent.height - self.height + MellowComponent.status-ring-width;
        status: status;
        ring-color: ring-color;
    }
}

// Red count badge, as on Discord rails and channel rows.
export component MentionBadge inherits Rectangle {
    in property <int> count;
    height: MellowComponent.badge-height;
    // Explicit width: outside a layout a Rectangle would otherwise take its parent's width.
    width: max(MellowComponent.badge-min-width, count-label.preferred-width + 2 * MellowComponent.badge-padding-inline);
    border-radius: MellowComponent.badge-radius;
    background: MellowComponent.badge-background;
    accessible-role: text;
    accessible-label: count + (count == 1 ? " mention" : " mentions");
    HorizontalLayout {
        padding-left: MellowComponent.badge-padding-inline;
        padding-right: MellowComponent.badge-padding-inline;
        count-label := Text {
            text: count > 99 ? "99+" : count;
            color: MellowComponent.badge-text;
            font-size: MellowType.badge.font-size;
            font-weight: MellowType.badge.font-weight;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
}

// Icon-sized square button with hover fill, used in the user panel and headers.
export component IconButton inherits Rectangle {
    in property <image> icon;
    in property <string> label;
    in property <length> size;
    in property <color> icon-color;
    in property <color> hover-icon-color: icon-color;
    in property <color> hover-background;
    // Whether Shift was held for the latest activation (click or key), read in `clicked` handlers:
    // Shift+click on Delete skips the confirmation, as on Discord.
    out property <bool> is-shift-held-on-activation;
    callback clicked();
    width: size;
    height: size;
    border-radius: MellowRadius.sm;
    background: touch.has-hover || focus-scope.has-focus ? hover-background : transparent;
    accessible-role: button;
    accessible-label: label;
    // Screen readers activate without a pointer event: a Shift left over from an earlier click
    // must not skip a confirmation.
    accessible-action-default => {
        root.is-shift-held-on-activation = false;
        root.clicked();
    }

    focus-scope := FocusScope {
        key-pressed(event) => {
            if event.text == " " || event.text == "\n" {
                root.is-shift-held-on-activation = event.modifiers.shift;
                root.clicked();
                return accept;
            }
            reject
        }
    }
    touch := TouchArea {
        pointer-event(event) => { root.is-shift-held-on-activation = event.modifiers.shift; }
        clicked => { root.clicked(); }
    }
    Image {
        source: icon;
        colorize: touch.has-hover || focus-scope.has-focus ? hover-icon-color : icon-color;
        // Phosphor icons are drawn on a 256 grid; at 62.5 % of the button they match Discord's 20-in-32.
        width: size * 0.625;
        height: self.width;
        accessible-role: none;
    }
    if focus-scope.has-focus: Rectangle {
        border-width: MellowComponent.focus-ring-width;
        border-color: MellowComponent.focus-ring-color;
        border-radius: parent.border-radius;
    }
}

// One context menu item (DESIGN.md §6.33). Hover fills it as on Discord; keyboard focus adds the
// focus ring, drawn outside the item so it stays visible on the danger fill.
export component ContextMenuItem inherits Rectangle {
    in property <string> label;
    in property <bool> is-danger: false;
    callback activated();
    height: MellowComponent.context-menu-item-height;
    border-radius: MellowComponent.context-menu-item-radius;
    background: !touch.has-hover ? transparent
        : is-danger ? MellowComponent.context-menu-danger-background-focus : MellowComponent.context-menu-item-background-focus;
    accessible-role: button;
    accessible-label: label;
    accessible-action-default => { root.activated(); }
    forward-focus: focus-scope;

    focus-scope := FocusScope {
        key-pressed(event) => {
            if event.text == " " || event.text == "\n" {
                root.activated();
                return accept;
            }
            reject
        }
    }
    touch := TouchArea { clicked => { root.activated(); } }
    Text {
        x: MellowComponent.context-menu-item-padding-inline;
        width: parent.width - 2 * MellowComponent.context-menu-item-padding-inline;
        text: label;
        color: is-danger
            ? (touch.has-hover ? MellowComponent.context-menu-danger-text-focus : MellowComponent.context-menu-danger-text)
            : (touch.has-hover ? MellowComponent.context-menu-item-text-focus : MellowComponent.context-menu-item-text);
        font-size: MellowType.menu-item.font-size;
        font-weight: MellowType.menu-item.font-weight;
        vertical-alignment: center;
        overflow: elide;
        accessible-role: none;
    }
    if focus-scope.has-focus: Rectangle {
        x: -MellowComponent.focus-ring-offset;
        y: -MellowComponent.focus-ring-offset;
        width: parent.width + 2 * MellowComponent.focus-ring-offset;
        height: parent.height + 2 * MellowComponent.focus-ring-offset;
        border-width: MellowComponent.focus-ring-width;
        border-color: MellowComponent.focus-ring-color;
        border-radius: parent.border-radius + MellowComponent.focus-ring-offset;
    }
}

// Dialog button (DESIGN.md §6.1): Secondary by default, Danger for the destructive action.
// shortcut: Secondary and Danger only; the login screen keeps its own Primary button until a third use.
export component Button inherits Rectangle {
    in property <string> label;
    in property <bool> is-danger: false;
    out property <bool> has-keyboard-focus: focus-scope.has-focus;
    callback clicked();
    height: MellowComponent.button-height;
    min-width: label-text.preferred-width + 2 * MellowComponent.button-padding-inline;
    border-radius: MellowComponent.button-radius;
    background: is-danger
        ? (touch.has-hover ? MellowComponent.button-danger-background-hover : MellowComponent.button-danger-background)
        : (touch.has-hover ? MellowComponent.button-secondary-background-hover : MellowComponent.button-secondary-background);
    accessible-role: button;
    accessible-label: label;
    accessible-action-default => { root.clicked(); }
    forward-focus: focus-scope;

    focus-scope := FocusScope {
        key-pressed(event) => {
            if event.text == " " || event.text == "\n" {
                root.clicked();
                return accept;
            }
            reject
        }
    }
    touch := TouchArea {
        mouse-cursor: MouseCursor.pointer;
        clicked => { root.clicked(); }
    }
    label-text := Text {
        text: label;
        color: is-danger ? MellowComponent.button-danger-text : MellowComponent.button-secondary-text;
        font-size: MellowType.button.font-size;
        font-weight: MellowType.button.font-weight;
        accessible-role: none;
    }
    // Outset ring with a gap, so it stays visible against the red and grey fills.
    if focus-scope.has-focus: Rectangle {
        x: -(MellowComponent.focus-ring-offset + MellowComponent.focus-ring-width);
        y: self.x;
        width: parent.width - 2 * self.x;
        height: parent.height - 2 * self.y;
        border-width: MellowComponent.focus-ring-width;
        border-color: MellowComponent.focus-ring-color;
        border-radius: MellowComponent.button-radius - self.x;
    }
}
