import { MellowColor, MellowComponent, MellowMotion, MellowRadius, MellowSize, MellowSpace, MellowTheme, MellowType } from "../tokens.slint";
import { MotionPreference } from "../preferences.slint";
import { Avatar, IconButton, PresenceStatus } from "primitives.slint";
import { ServerItem, ServerRail } from "server_rail.slint";
import { ChannelListGeometry, ChannelListRow, ChannelSidebar, DirectMessageRow } from "channel_sidebar.slint";
import { MelliState } from "melli.slint";

// The user card's surface: one step above the navigator in dark, the ground's tone in light, as
// in the reference mockup (ADR-0022).
global UserCardColor {
    out property <color> background: MellowTheme.is-dark ? MellowColor.surface-chat : MellowColor.surface-sidebar;
}

// Microphone or headset (ADR-0022 §5): a muted control turns `text.danger` and gets a strike-through,
// so the state never relies on colour alone.
component VoiceToggle inherits IconButton {
    in property <bool> is-muted;
    // The card's colour, cut around the strike so it reads over the glyph.
    in property <color> cut-color;
    size: MellowComponent.user-panel-button-size;
    icon-color: is-muted ? MellowComponent.user-panel-toggle-muted-icon : MellowComponent.user-panel-button-icon;
    hover-icon-color: is-muted ? MellowComponent.user-panel-toggle-muted-icon : MellowColor.text-normal;
    hover-background: MellowColor.state-selected;
    accessible-checkable: true;
    accessible-checked: is-muted;

    Rectangle {
        width: MellowComponent.user-panel-toggle-strike-width + 2 * MellowSpace.space-3xs;
        height: MellowComponent.user-panel-toggle-strike-length + 2 * MellowSpace.space-3xs;
        border-radius: self.width / 2;
        background: root.is-highlighted ? MellowColor.state-selected : root.cut-color;
        transform-rotation: -45deg;
        transform-scale-y: root.is-muted ? 1 : 0;
        // `motion.easing.enter`.
        animate transform-scale-y { duration: MotionPreference.fast; easing: cubic-bezier(0, 0, 0, 1); }
        Rectangle {
            width: MellowComponent.user-panel-toggle-strike-width;
            height: MellowComponent.user-panel-toggle-strike-length;
            border-radius: self.width / 2;
            background: MellowComponent.user-panel-toggle-muted-icon;
        }
    }
}

// The user card (ADR-0022 §4): as tall as the composer's base row and as far from the bottom of its
// card, so both line up across the window (`size.dock.*`).
component UserCard inherits Rectangle {
    in property <string> display-name;
    in property <string> initial;
    in property <int> tint;
    in property <string> username;
    in property <bool> has-update-available;
    // Microphone and headset show only in development builds until voice ships; the card keeps
    // its height either way, so nothing moves when they appear.
    in property <bool> shows-voice-controls;
    // Each increment moves focus to the settings button (when the settings screen closes).
    in property <int> settings-button-focus-request-count;
    callback open-user-settings();
    changed settings-button-focus-request-count => { settings-button.focus(); }

    // Voice does not exist yet: these only show the states (DESIGN.md §5.3). Deafening also mutes,
    // and undeafening restores the microphone, as on Discord.
    property <bool> is-microphone-muted;
    property <bool> is-deafened;
    property <bool> was-microphone-muted-before-deafening;
    function toggle-microphone() {
        if is-deafened {
            is-deafened = false;
            is-microphone-muted = false;
        } else {
            is-microphone-muted = !is-microphone-muted;
        }
    }
    function toggle-deafen() {
        if is-deafened {
            is-deafened = false;
            is-microphone-muted = was-microphone-muted-before-deafening;
        } else {
            was-microphone-muted-before-deafening = is-microphone-muted;
            is-deafened = true;
            is-microphone-muted = true;
        }
    }

    height: MellowSize.dock-height;
    border-radius: MellowComponent.user-panel-radius;
    background: UserCardColor.background;

    HorizontalLayout {
        padding-left: MellowSpace.xs;
        padding-right: MellowSpace.space-2xs;
        spacing: MellowSpace.xs;
        VerticalLayout {
            alignment: center;
            Avatar {
                initial: root.initial;
                tint-index: root.tint;
                size: MellowComponent.user-panel-avatar-size;
                has-presence: true;
                status: PresenceStatus.online;
                ring-color: UserCardColor.background;
            }
        }
        VerticalLayout {
            alignment: center;
            horizontal-stretch: 1;
            Text {
                text: root.display-name;
                color: MellowComponent.user-panel-name-text;
                font-size: MellowType.user-panel-name.font-size;
                font-weight: MellowType.user-panel-name.font-weight;
                overflow: elide;
            }
            if root.username != "": Text {
                text: "@" + root.username;
                color: MellowComponent.user-panel-status-text;
                font-size: MellowType.body-sm.font-size;
                overflow: elide;
            }
        }
        if root.shows-voice-controls: VerticalLayout {
            alignment: center;
            VoiceToggle {
                icon: @image-url("../../icons/microphone.svg");
                label: root.is-microphone-muted ? "Unmute" : "Mute";
                is-muted: root.is-microphone-muted;
                cut-color: UserCardColor.background;
                clicked => { root.toggle-microphone(); }
            }
        }
        if root.shows-voice-controls: VerticalLayout {
            alignment: center;
            VoiceToggle {
                icon: @image-url("../../icons/headphones.svg");
                label: root.is-deafened ? "Undeafen" : "Deafen";
                is-muted: root.is-deafened;
                cut-color: UserCardColor.background;
                clicked => { root.toggle-deafen(); }
            }
        }
        VerticalLayout {
            alignment: center;
            settings-button := IconButton {
                icon: @image-url("../../icons/gear-six.svg");
                label: root.has-update-available ? "User settings, update available" : "User settings";
                size: MellowComponent.user-panel-button-size;
                icon-color: MellowComponent.user-panel-button-icon;
                hover-icon-color: MellowColor.text-normal;
                hover-background: MellowColor.state-selected;
                clicked => { root.open-user-settings(); }

                // Green dot at the top trailing corner, cut out of the card like presence dots.
                if root.has-update-available: Rectangle {
                    width: MellowComponent.user-panel-update-badge-size + 2 * MellowComponent.user-panel-update-badge-ring-width;
                    height: self.width;
                    x: parent.width - self.width + MellowComponent.user-panel-update-badge-ring-width;
                    y: -MellowComponent.user-panel-update-badge-ring-width;
                    border-radius: self.width / 2;
                    background: UserCardColor.background;
                    Rectangle {
                        width: MellowComponent.user-panel-update-badge-size;
                        height: self.width;
                        border-radius: self.width / 2;
                        background: MellowComponent.user-panel-update-badge;
                    }
                }
            }
        }
    }
}

// The navigator (ADR-0022 §1): one card holding the server strip, the channel list of the current
// server and, across both, the user card. Servers and channels read as one object: where I am.
export component Navigator inherits Rectangle {
    // Rail.
    in property <[ServerItem]> servers;
    in property <int> selected-server-index;
    in property <bool> has-unread-direct-messages;
    in property <MelliState> home-melli-state;
    callback select-server(int);
    callback add-server();
    // Channel list.
    in property <string> server-name;
    in property <[ChannelListRow]> channel-rows;
    in property <string> selected-channel-id;
    in property <bool> is-home;
    in property <[DirectMessageRow]> direct-message-rows;
    in property <bool> can-invite-people;
    in property <bool> can-open-server-settings;
    in property <bool> can-create-channels;
    in property <bool> can-leave-server;
    in property <int> server-header-focus-request-count;
    callback toggle-category(int);
    callback select-channel(string);
    callback invite-people();
    callback open-server-settings();
    callback create-channel();
    callback leave-server();
    // User card.
    in property <string> current-user-name;
    in property <string> current-user-initial;
    in property <int> current-user-tint;
    in property <string> current-username;
    in property <bool> has-update-available;
    in property <bool> shows-voice-controls;
    in property <int> settings-button-focus-request-count;
    callback open-user-settings();

    width: MellowComponent.navigator-strip-width + MellowComponent.sidebar-width;
    background: MellowComponent.navigator-background;
    border-radius: MellowComponent.navigator-radius;
    accessible-role: navigation;
    accessible-label: "Servers and channels";

    VerticalLayout {
        padding-bottom: MellowSize.dock-margin;
        Rectangle {
            vertical-stretch: 1;
            ServerRail {
                x: 0;
                height: parent.height;
                servers: root.servers;
                selected-server-index: root.selected-server-index;
                has-unread-direct-messages: root.has-unread-direct-messages;
                home-melli-state: root.home-melli-state;
                select-server(index) => { root.select-server(index); }
                add-server => { root.add-server(); }
            }
            // Reaches back into the strip, so its unread pills sit just after the server icons.
            ChannelSidebar {
                x: MellowComponent.navigator-strip-width - ChannelListGeometry.leading-reach;
                height: parent.height;
                server-name: root.server-name;
                rows: root.channel-rows;
                is-home: root.is-home;
                direct-message-rows: root.direct-message-rows;
                selected-channel-id: root.selected-channel-id;
                can-invite-people: root.can-invite-people;
                can-open-server-settings: root.can-open-server-settings;
                can-create-channels: root.can-create-channels;
                can-leave-server: root.can-leave-server;
                server-header-focus-request-count: root.server-header-focus-request-count;
                toggle-category(index) => { root.toggle-category(index); }
                select-channel(id) => { root.select-channel(id); }
                invite-people => { root.invite-people(); }
                open-server-settings => { root.open-server-settings(); }
                create-channel => { root.create-channel(); }
                leave-server => { root.leave-server(); }
            }
        }
        HorizontalLayout {
            padding-left: MellowSize.dock-margin;
            padding-right: MellowSize.dock-margin;
            UserCard {
                display-name: root.current-user-name;
                initial: root.current-user-initial;
                tint: root.current-user-tint;
                username: root.current-username;
                has-update-available: root.has-update-available;
                shows-voice-controls: root.shows-voice-controls;
                settings-button-focus-request-count: root.settings-button-focus-request-count;
                open-user-settings => { root.open-user-settings(); }
            }
        }
    }
}
