import { ListView } from "std-widgets.slint";
import { MellowColor, MellowComponent, MellowSize, MellowSpace, MellowType } from "../tokens.slint";
import { Avatar, ContextMenuItem, IconButton, MentionBadge, PresenceStatus } from "primitives.slint";

// Categories and channels flattened into one list, so ListView can virtualize long servers.
export struct ChannelListRow {
    // Channel id (names are not unique within a guild); empty for category headers.
    id: string,
    is-category: bool,
    is-collapsed: bool,
    category-index: int,
    name: string,
    // Uppercased in Rust: Slint has no text-transform, and screen readers must get `name`.
    display-name: string,
    has-unread: bool,
    mention-count: int,
    // The signed-in user cannot send messages there: a lock replaces `#` (DESIGN.md §5.3).
    is-read-only: bool,
}

// One conversation on Home (DESIGN.md §5.6); `id` is the conversation's channel id.
export struct DirectMessageRow {
    id: string,
    name: string,
    initial: string,
    status: PresenceStatus,
    has-unread: bool,
}

component CategoryHeader inherits Rectangle {
    in property <string> name;
    in property <string> display-name;
    in property <bool> is-collapsed;
    callback toggled();
    height: MellowComponent.category-margin-top + MellowComponent.category-height;
    accessible-role: button;
    accessible-label: name;
    accessible-expandable: true;
    accessible-expanded: !is-collapsed;
    accessible-action-default => { root.toggled(); }

    property <color> text-color: touch.has-hover || focus-scope.has-focus
        ? MellowComponent.category-text-hover : MellowComponent.category-text;

    // Enter/Space toggle; Left collapses and Right expands, as on Discord (DESIGN.md §5.3).
    focus-scope := FocusScope {
        key-pressed(event) => {
            if event.text == " " || event.text == "\n"
                || (event.text == Key.LeftArrow && !root.is-collapsed)
                || (event.text == Key.RightArrow && root.is-collapsed) {
                root.toggled();
                return accept;
            }
            reject
        }
    }
    touch := TouchArea { clicked => { root.toggled(); } }
    HorizontalLayout {
        padding-top: MellowComponent.category-margin-top;
        padding-left: MellowComponent.category-padding-inline;
        spacing: MellowSpace.space-3xs;
        VerticalLayout {
            alignment: center;
            Image {
                source: is-collapsed ? @image-url("../../icons/caret-right.svg") : @image-url("../../icons/caret-down.svg");
                colorize: root.text-color;
                width: MellowComponent.category-chevron-size;
                height: self.width;
                accessible-role: none;
            }
        }
        Text {
            text: display-name;
            accessible-role: none;
            color: root.text-color;
            font-size: MellowType.category.font-size;
            font-weight: MellowType.category.font-weight;
            letter-spacing: MellowType.category.letter-spacing;
            vertical-alignment: center;
            overflow: elide;
        }
    }
    if focus-scope.has-focus: Rectangle {
        y: MellowComponent.category-margin-top;
        height: MellowComponent.category-height;
        border-width: MellowComponent.focus-ring-width;
        border-color: MellowComponent.focus-ring-color;
        border-radius: MellowComponent.channel-row-radius;
    }
}

component ChannelRow inherits Rectangle {
    in property <string> name;
    in property <bool> is-selected;
    in property <bool> has-unread;
    in property <int> mention-count;
    in property <bool> is-read-only;
    callback clicked();
    height: MellowComponent.channel-row-height + MellowComponent.channel-row-gap;
    accessible-role: list-item;
    accessible-label: name + (is-read-only ? ", read-only" : "") + (mention-count == 1 ? ", 1 mention" : mention-count > 1 ? ", " + mention-count + " mentions" : has-unread ? ", unread" : "");
    accessible-item-selected: is-selected;
    accessible-action-default => { root.clicked(); }

    if has-unread && !is-selected: Rectangle {
        x: 0;
        width: MellowComponent.channel-row-unread-pill-width;
        height: MellowComponent.channel-row-unread-pill-height;
        border-radius: self.width / 2;
        background: MellowComponent.channel-row-unread-pill-color;
    }

    focus-scope := FocusScope {
        key-pressed(event) => {
            if event.text == " " || event.text == "\n" {
                root.clicked();
                return accept;
            }
            reject
        }
    }

    row := Rectangle {
        x: MellowComponent.channel-row-margin-inline;
        width: parent.width - 2 * MellowComponent.channel-row-margin-inline;
        height: MellowComponent.channel-row-height;
        border-radius: MellowComponent.channel-row-radius;
        background: is-selected ? MellowComponent.channel-row-background-selected
            : touch.has-hover || focus-scope.has-focus ? MellowComponent.channel-row-background-hover : transparent;
        border-width: focus-scope.has-focus ? MellowComponent.focus-ring-width : 0px;
        border-color: MellowComponent.focus-ring-color;

        property <color> text-color: is-selected ? MellowComponent.channel-row-text-selected
            : touch.has-hover || focus-scope.has-focus ? MellowComponent.channel-row-text-hover
            : has-unread ? MellowComponent.channel-row-text-unread : MellowComponent.channel-row-text-read;

        touch := TouchArea { clicked => { root.clicked(); } }
        HorizontalLayout {
            padding-left: MellowComponent.channel-row-padding-inline;
            padding-right: MellowComponent.channel-row-padding-inline;
            spacing: MellowComponent.channel-row-icon-gap;
            VerticalLayout {
                alignment: center;
                Image {
                    source: is-read-only ? @image-url("../../icons/lock.svg") : @image-url("../../icons/hash.svg");
                    colorize: row.text-color;
                    width: MellowComponent.channel-row-icon-size;
                    height: self.width;
                    accessible-role: none;
                }
            }
            Text {
                text: name;
                color: row.text-color;
                font-size: MellowType.channel-name.font-size;
                font-weight: has-unread || is-selected ? MellowType.message-author.font-weight : MellowType.channel-name.font-weight;
                vertical-alignment: center;
                overflow: elide;
                horizontal-stretch: 1;
                accessible-role: none;
            }
            if mention-count > 0: VerticalLayout {
                alignment: center;
                MentionBadge { count: mention-count; }
            }
        }
    }
}

// Discord's "Direct messages" header: category type, not collapsible.
component DirectMessagesHeader inherits Rectangle {
    height: MellowComponent.category-margin-top + MellowComponent.category-height;
    accessible-role: text;
    accessible-label: "Direct messages";
    Text {
        x: MellowComponent.category-padding-inline;
        y: MellowComponent.category-margin-top;
        height: MellowComponent.category-height;
        // Uppercase copy of the accessible label: Slint has no text-transform.
        text: "DIRECT MESSAGES";
        accessible-role: none;
        color: MellowComponent.category-text;
        font-size: MellowType.category.font-size;
        font-weight: MellowType.category.font-weight;
        letter-spacing: MellowType.category.letter-spacing;
        vertical-alignment: center;
    }
}

// A conversation row: same states as a channel row, with the person's avatar instead of `#`.
component ConversationRow inherits Rectangle {
    in property <DirectMessageRow> conversation;
    in property <bool> is-selected;
    callback clicked();
    height: MellowComponent.conversation-row-height + MellowComponent.channel-row-gap;
    accessible-role: list-item;
    accessible-label: conversation.name
        + (conversation.status == PresenceStatus.online ? ", online"
            : conversation.status == PresenceStatus.idle ? ", idle"
            : conversation.status == PresenceStatus.do-not-disturb ? ", do not disturb" : ", offline")
        + (conversation.has-unread ? ", unread" : "");
    accessible-item-selected: is-selected;
    accessible-action-default => { root.clicked(); }

    if conversation.has-unread && !is-selected: Rectangle {
        x: 0;
        y: (MellowComponent.conversation-row-height - self.height) / 2;
        width: MellowComponent.channel-row-unread-pill-width;
        height: MellowComponent.channel-row-unread-pill-height;
        border-radius: self.width / 2;
        background: MellowComponent.channel-row-unread-pill-color;
    }

    focus-scope := FocusScope {
        key-pressed(event) => {
            if event.text == " " || event.text == "\n" {
                root.clicked();
                return accept;
            }
            reject
        }
    }

    row := Rectangle {
        x: MellowComponent.channel-row-margin-inline;
        width: parent.width - 2 * MellowComponent.channel-row-margin-inline;
        height: MellowComponent.conversation-row-height;
        border-radius: MellowComponent.channel-row-radius;
        background: is-selected ? MellowComponent.channel-row-background-selected
            : touch.has-hover || focus-scope.has-focus ? MellowComponent.channel-row-background-hover
            : MellowComponent.sidebar-background;
        border-width: focus-scope.has-focus ? MellowComponent.focus-ring-width : 0px;
        border-color: MellowComponent.focus-ring-color;

        property <color> text-color: is-selected ? MellowComponent.channel-row-text-selected
            : touch.has-hover || focus-scope.has-focus ? MellowComponent.channel-row-text-hover
            : conversation.has-unread ? MellowComponent.channel-row-text-unread : MellowComponent.channel-row-text-read;

        touch := TouchArea { clicked => { root.clicked(); } }
        HorizontalLayout {
            padding-left: MellowComponent.channel-row-padding-inline;
            padding-right: MellowComponent.channel-row-padding-inline;
            spacing: MellowComponent.conversation-row-avatar-gap;
            VerticalLayout {
                alignment: center;
                Avatar {
                    initial: conversation.initial;
                    size: MellowComponent.conversation-row-avatar-size;
                    has-presence: true;
                    status: conversation.status;
                    // The status dot's cut-out follows the row's own background.
                    ring-color: row.background;
                }
            }
            Text {
                text: conversation.name;
                color: row.text-color;
                font-size: MellowType.channel-name.font-size;
                font-weight: conversation.has-unread || is-selected ? MellowType.message-author.font-weight : MellowType.channel-name.font-weight;
                vertical-alignment: center;
                overflow: elide;
                horizontal-stretch: 1;
                accessible-role: none;
            }
        }
    }
}

component UserPanel inherits Rectangle {
    in property <string> display-name;
    in property <string> initial;
    in property <string> status-text;
    in property <bool> has-update-available;
    // Each increment moves focus to the settings button (when the settings screen closes).
    in property <int> settings-button-focus-request-count;
    callback open-user-settings();
    changed settings-button-focus-request-count => { settings-button.focus(); }
    height: MellowComponent.user-panel-height;
    background: MellowComponent.user-panel-background;
    HorizontalLayout {
        padding-left: MellowComponent.user-panel-padding-inline;
        padding-right: MellowComponent.user-panel-padding-inline;
        spacing: MellowSpace.xs;
        alignment: stretch;
        VerticalLayout {
            alignment: center;
            Avatar {
                initial: root.initial;
                size: MellowComponent.user-panel-avatar-size;
                has-presence: true;
                status: PresenceStatus.online;
                ring-color: MellowComponent.user-panel-background;
            }
        }
        VerticalLayout {
            alignment: center;
            horizontal-stretch: 1;
            Text {
                text: display-name;
                color: MellowComponent.user-panel-name-text;
                font-size: MellowType.user-panel-name.font-size;
                font-weight: MellowType.user-panel-name.font-weight;
                overflow: elide;
            }
            Text {
                text: status-text;
                color: MellowComponent.user-panel-status-text;
                font-size: MellowType.body-sm.font-size;
                overflow: elide;
            }
        }
        for button in [
            { icon: @image-url("../../icons/microphone.svg"), label: "Mute" },
            { icon: @image-url("../../icons/headphones.svg"), label: "Deafen" },
        ]: VerticalLayout {
            alignment: center;
            IconButton {
                icon: button.icon;
                label: button.label;
                size: MellowComponent.user-panel-button-size;
                icon-color: MellowComponent.user-panel-button-icon;
                hover-background: MellowComponent.user-panel-button-background-hover;
            }
        }
        VerticalLayout {
            alignment: center;
            settings-button := IconButton {
                icon: @image-url("../../icons/gear-six.svg");
                label: root.has-update-available ? "User settings, update available" : "User settings";
                size: MellowComponent.user-panel-button-size;
                icon-color: MellowComponent.user-panel-button-icon;
                hover-background: MellowComponent.user-panel-button-background-hover;
                clicked => { root.open-user-settings(); }

                // Green dot at the top trailing corner, cut out of the panel like presence dots.
                if root.has-update-available: Rectangle {
                    width: MellowComponent.user-panel-update-badge-size + 2 * MellowComponent.user-panel-update-badge-ring-width;
                    height: self.width;
                    x: parent.width - self.width + MellowComponent.user-panel-update-badge-ring-width;
                    y: -MellowComponent.user-panel-update-badge-ring-width;
                    border-radius: self.width / 2;
                    background: MellowComponent.user-panel-background;
                    Rectangle {
                        width: MellowComponent.user-panel-update-badge-size;
                        height: self.width;
                        border-radius: self.width / 2;
                        background: MellowComponent.user-panel-update-badge;
                    }
                }
            }
        }
    }
}

export component ChannelSidebar inherits Rectangle {
    in property <string> server-name;
    in property <[ChannelListRow]> rows;
    in property <string> selected-channel-id;
    in property <string> current-user-name;
    in property <string> current-user-initial;
    callback toggle-category(int);
    callback select-channel(string);
    in property <bool> has-update-available;
    in property <int> settings-button-focus-request-count;
    callback open-user-settings();
    // Server menu (DESIGN.md §5.3): each item shows only when allowed; without any, the header
    // stays plain text.
    in property <bool> can-invite-people;
    in property <bool> can-open-server-settings;
    in property <bool> can-create-channels;
    in property <bool> can-leave-server;
    // Each increment moves focus to the server header (when server settings close).
    in property <int> server-header-focus-request-count;
    callback invite-people();
    callback open-server-settings();
    callback create-channel();
    callback leave-server();
    changed server-header-focus-request-count => { header-focus.focus(); }
    // Home: conversations replace categories and channels, and the header is plain text.
    in property <bool> is-home;
    in property <[DirectMessageRow]> direct-message-rows;

    property <bool> has-items-above-leave: can-invite-people || can-open-server-settings || can-create-channels;
    property <bool> has-server-menu: !is-home && (has-items-above-leave || can-leave-server);
    property <string> header-text: is-home ? "Direct messages" : server-name;

    function open-server-menu() {
        if root.has-server-menu {
            server-menu.show();
        }
    }

    width: MellowComponent.sidebar-width;
    background: MellowComponent.sidebar-background;

    // Esc and clicks outside close it; Slint then gives focus back to the header.
    server-menu := PopupWindow {
        x: MellowComponent.sidebar-header-menu-margin;
        y: MellowComponent.sidebar-header-height + MellowComponent.sidebar-header-menu-margin;
        width: root.width - 2 * MellowComponent.sidebar-header-menu-margin;
        close-policy: close-on-click-outside;

        Rectangle {
            background: MellowComponent.context-menu-background;
            border-radius: MellowComponent.context-menu-radius;
            border-width: MellowComponent.context-menu-border-width;
            border-color: MellowComponent.context-menu-border;
            accessible-role: list;
            accessible-label: "Server menu";
            // The first item shown takes focus when the menu opens (DESIGN.md §6.33).
            VerticalLayout {
                padding: MellowComponent.context-menu-padding;
                if root.can-invite-people: ContextMenuItem {
                    label: "Invite people";
                    is-accent: true;
                    icon: @image-url("../../icons/user-plus.svg");
                    init => { self.focus(); }
                    activated => {
                        server-menu.close();
                        root.invite-people();
                    }
                }
                if root.can-open-server-settings: ContextMenuItem {
                    label: "Server settings";
                    icon: @image-url("../../icons/gear-six.svg");
                    init => {
                        if !root.can-invite-people {
                            self.focus();
                        }
                    }
                    activated => {
                        server-menu.close();
                        root.open-server-settings();
                    }
                }
                if root.can-create-channels: ContextMenuItem {
                    label: "Create channel";
                    icon: @image-url("../../icons/plus-circle.svg");
                    init => {
                        if !root.can-invite-people && !root.can-open-server-settings {
                            self.focus();
                        }
                    }
                    activated => {
                        server-menu.close();
                        root.create-channel();
                    }
                }
                // Danger items come last, separated (DESIGN.md §6.33).
                if root.can-leave-server && root.has-items-above-leave: Rectangle {
                    height: MellowComponent.context-menu-separator-height + 2 * MellowComponent.context-menu-separator-margin-block;
                    Rectangle {
                        x: MellowComponent.context-menu-separator-margin-inline;
                        width: parent.width - 2 * MellowComponent.context-menu-separator-margin-inline;
                        height: MellowComponent.context-menu-separator-height;
                        background: MellowComponent.context-menu-separator;
                    }
                }
                if root.can-leave-server: ContextMenuItem {
                    label: "Leave server";
                    is-danger: true;
                    icon: @image-url("../../icons/sign-out.svg");
                    init => {
                        if !root.has-items-above-leave {
                            self.focus();
                        }
                    }
                    activated => {
                        server-menu.close();
                        root.leave-server();
                    }
                }
            }
        }
    }

    VerticalLayout {
        header := Rectangle {
            height: MellowComponent.sidebar-header-height;
            background: root.has-server-menu && (header-touch.has-hover || server-menu.is-open)
                ? MellowComponent.sidebar-header-background-hover : transparent;

            // A button opening the server menu only when the menu has something in it; plain text
            // otherwise. Hidden items leave the accessibility tree and the Tab order.
            Rectangle {
                visible: !root.has-server-menu;
                accessible-role: text;
                accessible-label: root.header-text;
            }
            Rectangle {
                visible: root.has-server-menu;
                accessible-role: button;
                accessible-label: root.header-text;
                accessible-expandable: true;
                accessible-expanded: server-menu.is-open;
                accessible-action-default => { root.open-server-menu(); }
                forward-focus: header-focus;

                header-focus := FocusScope {
                    key-pressed(event) => {
                        if event.text == " " || event.text == "\n" {
                            root.open-server-menu();
                            return accept;
                        }
                        reject
                    }
                }
                header-touch := TouchArea {
                    mouse-cursor: MouseCursor.pointer;
                    clicked => {
                        header-focus.focus();
                        root.open-server-menu();
                    }
                }
            }
            HorizontalLayout {
                padding-left: MellowComponent.sidebar-header-padding-inline;
                padding-right: MellowComponent.sidebar-header-padding-inline;
                spacing: MellowSpace.xs;
                Text {
                    text: root.header-text;
                    color: MellowComponent.sidebar-header-text;
                    font-size: MellowType.heading-md.font-size;
                    font-weight: MellowType.heading-md.font-weight;
                    vertical-alignment: center;
                    overflow: elide;
                    horizontal-stretch: 1;
                    accessible-role: none;
                }
                // Chevron, or a cross while the menu is open, as on Discord.
                if root.has-server-menu: VerticalLayout {
                    alignment: center;
                    Image {
                        source: server-menu.is-open ? @image-url("../../icons/x.svg") : @image-url("../../icons/caret-down.svg");
                        colorize: MellowComponent.sidebar-header-text;
                        width: MellowComponent.sidebar-header-chevron-size;
                        height: self.width;
                        accessible-role: none;
                    }
                }
            }
            if header-focus.has-focus: Rectangle {
                border-width: MellowComponent.focus-ring-width;
                border-color: MellowComponent.focus-ring-color;
            }
            Rectangle {
                y: parent.height - 1px;
                height: 1px;
                background: MellowColor.border-divider;
            }
        }

        if root.is-home: VerticalLayout {
            vertical-stretch: 1;
            DirectMessagesHeader { }
            if root.direct-message-rows.length == 0: VerticalLayout {
                padding: MellowComponent.conversation-row-empty-padding;
                alignment: start;
                vertical-stretch: 1;
                Text {
                    text: "No conversations yet. Start one with someone from your servers.";
                    color: MellowComponent.conversation-row-empty-text;
                    font-size: MellowType.body.font-size;
                    wrap: word-wrap;
                    accessible-role: text;
                }
            }
            if root.direct-message-rows.length > 0: ListView {
                vertical-stretch: 1;
                accessible-role: list;
                accessible-label: "Direct messages";
                for conversation in root.direct-message-rows: ConversationRow {
                    conversation: conversation;
                    is-selected: conversation.id == root.selected-channel-id;
                    clicked => { root.select-channel(conversation.id); }
                }
            }
        }

        if !root.is-home: ListView {
            vertical-stretch: 1;
            accessible-role: list;
            accessible-label: "Channels";
            for row in rows: VerticalLayout {
                if row.is-category: CategoryHeader {
                    name: row.name;
                    display-name: row.display-name;
                    is-collapsed: row.is-collapsed;
                    toggled => { root.toggle-category(row.category-index); }
                }
                if !row.is-category: ChannelRow {
                    name: row.name;
                    has-unread: row.has-unread;
                    mention-count: row.mention-count;
                    is-read-only: row.is-read-only;
                    is-selected: row.id == selected-channel-id;
                    clicked => { root.select-channel(row.id); }
                }
            }
        }

        UserPanel {
            display-name: current-user-name;
            initial: current-user-initial;
            status-text: "Online";
            has-update-available: root.has-update-available;
            settings-button-focus-request-count: root.settings-button-focus-request-count;
            open-user-settings => { root.open-user-settings(); }
        }
    }
}
