import { MellowColor, MellowComponent, MellowMotion, MellowRadius, MellowSize, MellowSpace, MellowType } from "../tokens.slint";
import { MotionPreference } from "../preferences.slint";
import { MentionBadge } from "primitives.slint";
import { Melli, MelliState } from "melli.slint";

export struct ServerItem {
    name: string,
    initials: string,
    has-unread: bool,
    mention-count: int,
}

// One strip entry: 48 px icon that morphs circle → squircle on hover/selection, with the pill at
// the navigator's leading edge showing unread (short), hover (medium) or selected (tall, apricot).
component RailItem inherits Rectangle {
    in property <string> label;
    in property <string> initials;
    in property <bool> is-selected;
    in property <bool> has-unread;
    in property <int> mention-count;
    // Home shows Melli instead of initials: on the navigator at rest, on apricot when active.
    in property <bool> is-home: false;
    in property <MelliState> melli-state;
    // When set, drawn instead of `initials` (e.g. the "add a server" action).
    in property <image> icon;
    in property <bool> has-icon: false;
    out property <bool> is-hovered: touch.has-hover;
    callback clicked();

    property <bool> is-active: is-selected || touch.has-hover || focus-scope.has-focus;

    width: MellowComponent.navigator-strip-width;
    height: MellowComponent.rail-item-size;
    accessible-role: tab;
    accessible-label: label + (mention-count == 1 ? ", 1 mention" : mention-count > 1 ? ", " + mention-count + " mentions" : has-unread ? ", unread" : "");
    accessible-item-selected: is-selected;
    accessible-action-default => { root.clicked(); }

    // Half the pill shows: it sits against the navigator card's inner edge (ADR-0022).
    if !has-icon: Rectangle {
        x: 0;
        width: MellowComponent.rail-pill-width / 2;
        height: is-selected ? MellowComponent.rail-pill-height-selected
            : touch.has-hover || focus-scope.has-focus ? MellowComponent.rail-pill-height-hover
            : has-unread ? MellowComponent.rail-pill-height-unread : 0px;
        y: (parent.height - self.height) / 2;
        border-top-right-radius: MellowRadius.full;
        border-bottom-right-radius: MellowRadius.full;
        background: is-selected ? MellowComponent.rail-pill-color-selected : MellowComponent.rail-pill-color;
        // `motion.easing.standard`: Slint globals cannot hold an easing curve.
        animate height { duration: MotionPreference.base; easing: cubic-bezier(0.2, 0, 0, 1); }
        animate background { duration: MellowMotion.duration-fast; easing: cubic-bezier(0.2, 0, 0, 1); }
    }

    icon := Rectangle {
        width: MellowComponent.rail-item-size;
        height: MellowComponent.rail-item-size;
        border-radius: is-active ? MellowComponent.rail-icon-radius-active : MellowComponent.rail-icon-radius-rest;
        // Home lights apricot and "Add a server" green; servers step up one tone.
        background: is-home ? (is-active ? MellowColor.accent-fill : transparent)
            : has-icon ? (is-active ? MellowComponent.rail-add-background-hover : MellowComponent.rail-icon-background-rest)
            : is-active ? MellowComponent.rail-icon-background-active : MellowComponent.rail-icon-background-rest;
        // The squircle lands with `motion.easing.settle`; colours use `motion.easing.standard`.
        animate border-radius { duration: MotionPreference.settle; easing: cubic-bezier(0.34, 1.3, 0.64, 1); }
        animate background { duration: MellowMotion.duration-fast; easing: cubic-bezier(0.2, 0, 0, 1); }
        if has-icon: Image {
            source: root.icon;
            colorize: is-active ? MellowComponent.rail-add-icon-hover : MellowComponent.rail-add-icon;
            width: MellowComponent.rail-item-size / 2;
            height: self.width;
            accessible-role: none;
        }
        if is-home: Melli {
            width: parent.width;
            height: parent.height;
            state: root.melli-state;
            mark-color: is-active ? MellowColor.mascot-ink : MellowColor.mascot-mark;
        }
        if !has-icon && !is-home: Text {
            text: initials;
            color: is-active ? MellowComponent.rail-icon-text-active : MellowComponent.rail-icon-text-rest;
            font-size: MellowType.body.font-size;
            font-weight: MellowType.message-author.font-weight;
            animate color { duration: MellowMotion.duration-fast; easing: cubic-bezier(0.2, 0, 0, 1); }
        }
    }

    // The badge overhangs the icon's bottom trailing corner, its ring cut out of the navigator.
    if mention-count > 0: Rectangle {
        x: icon.x + icon.width + MellowSpace.space-2xs + MellowComponent.badge-ring-width - self.width;
        y: icon.y + icon.height + MellowSpace.space-2xs + MellowComponent.badge-ring-width - self.height;
        width: badge.width + 2 * MellowComponent.badge-ring-width;
        height: badge.height + 2 * MellowComponent.badge-ring-width;
        border-radius: self.height / 2;
        background: MellowComponent.navigator-background;
        badge := MentionBadge {
            count: root.mention-count;
        }
    }

    focus-scope := FocusScope {
        key-pressed(event) => {
            if event.text == " " || event.text == "\n" {
                root.clicked();
                return accept;
            }
            reject
        }
    }
    touch := TouchArea {
        x: icon.x;
        width: icon.width;
        mouse-cursor: MouseCursor.pointer;
        clicked => { root.clicked(); }
    }
    if focus-scope.has-focus: Rectangle {
        x: icon.x - MellowComponent.focus-ring-offset;
        width: icon.width + 2 * MellowComponent.focus-ring-offset;
        height: icon.height + 2 * MellowComponent.focus-ring-offset;
        border-radius: icon.border-radius + MellowComponent.focus-ring-offset;
        border-width: MellowComponent.focus-ring-width;
        border-color: MellowComponent.focus-ring-color;
    }
}

// The server strip, the navigator card's first column (DESIGN.md §4.2). It has no surface of its
// own: the navigator card shows through.
export component ServerRail inherits Rectangle {
    in property <[ServerItem]> servers;
    in-out property <int> selected-server-index;
    in property <bool> has-unread-direct-messages;
    in property <MelliState> home-melli-state;
    callback select-server(int);
    callback add-server();

    width: MellowComponent.navigator-strip-width;
    accessible-role: tab-list;
    accessible-label: "Servers";

    Flickable {
        VerticalLayout {
            padding-top: MellowComponent.rail-padding-top;
            padding-bottom: MellowComponent.rail-padding-top;
            spacing: MellowComponent.rail-item-gap;
            alignment: start;

            // Home / direct messages, with Melli (DESIGN.md §2.10). The name and the pill say unread.
            RailItem {
                label: "Direct messages";
                is-home: true;
                melli-state: root.home-melli-state;
                has-unread: root.has-unread-direct-messages;
                // -1 is the home index; main.rs maps any negative index to HOME_SERVER_NAME.
                is-selected: selected-server-index == -1;
                clicked => { root.select-server(-1); }
            }
            HorizontalLayout {
                alignment: center;
                Rectangle {
                    width: MellowSize.rail-separator-width;
                    height: MellowSize.rail-separator-height;
                    border-radius: self.height / 2;
                    background: MellowComponent.rail-separator-color;
                }
            }
            for server[index] in servers: RailItem {
                label: server.name;
                initials: server.initials;
                has-unread: server.has-unread;
                mention-count: server.mention-count;
                is-selected: index == selected-server-index;
                clicked => { root.select-server(index); }
            }
            RailItem {
                label: "Add a server";
                icon: @image-url("../../icons/plus.svg");
                has-icon: true;
                // An action, not a server to switch to.
                accessible-role: button;
                clicked => { root.add-server(); }
            }
        }
    }
}
