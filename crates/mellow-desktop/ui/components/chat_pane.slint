import { ListView } from "std-widgets.slint";
import { MellowColor, MellowComponent, MellowMotion, MellowRadius, MellowSize, MellowSpace, MellowType } from "../tokens.slint";
import { Avatar, Button, IconButton } from "primitives.slint";

// Where a message the signed-in user sent stands: confirmed by the server, or still in the outbox.
export enum MessageDelivery { sent, sending, failed }
// What sits above the oldest loaded message (DESIGN.md §5.4 "List states"): nothing while older
// history may exist, skeletons while a page loads, an error with "Try again", or the channel-start hero.
export enum HistoryStartState { unknown, loading, failed, channel-start }

export struct MessageRow {
    author: string,
    author-initial: string,
    timestamp: string,
    // Time of day only, shown in the gutter when a grouped message is hovered.
    short-time: string,
    body: styled-text,
    // Source text: copied by "Copy text", read by screen readers, shown in selection mode.
    body-plain: string,
    starts-author-group: bool,
    reply-preview: string,
    mentions-current-user: bool,
    // The signed-in user wrote it: only then is Edit offered.
    is-own: bool,
    // Delete is offered: the user's own message, or someone else's with Manage Messages.
    can-delete: bool,
    is-edited: bool,
    // Sending and failed rows are the user's own, after every confirmed row; they offer no message actions.
    delivery: MessageDelivery,
}

component HoverActionBar inherits Rectangle {
    in property <bool> is-own;
    in property <bool> can-delete;
    // False where the user cannot send messages: a reply could not be posted.
    in property <bool> can-reply;
    // True while the pointer is on the bar, which sticks out above its message row.
    out property <bool> is-hovered: hover-area.has-hover;
    callback edit();
    callback reply();
    callback copy-text();
    // True when Shift was held: delete without the confirmation dialog, as on Discord.
    callback delete(bool);
    // Without it a Rectangle fills its parent: the bar spanned the row and pushed its buttons off the left edge.
    width: action-buttons.preferred-width;
    height: MellowComponent.action-bar-height;
    border-radius: MellowComponent.action-bar-radius;
    border-width: 1px;
    border-color: MellowComponent.action-bar-border;
    background: MellowComponent.action-bar-background;
    // shortcut: Edit and Delete sit in the bar itself until the More menu (DESIGN.md §5.4) exists;
    // Reply stays on your own messages for the same reason.
    hover-area := TouchArea {
        action-buttons := HorizontalLayout {
            if root.is-own: IconButton {
                icon: @image-url("../../icons/pencil-simple.svg");
                label: "Edit";
                size: MellowComponent.action-bar-button-size;
                icon-color: MellowComponent.action-bar-icon;
                hover-icon-color: MellowComponent.action-bar-icon-hover;
                hover-background: MellowComponent.action-bar-button-background-hover;
                clicked => { root.edit(); }
            }
            if root.can-reply: IconButton {
                icon: @image-url("../../icons/arrow-bend-up-left.svg");
                label: "Reply";
                size: MellowComponent.action-bar-button-size;
                icon-color: MellowComponent.action-bar-icon;
                hover-icon-color: MellowComponent.action-bar-icon-hover;
                hover-background: MellowComponent.action-bar-button-background-hover;
                clicked => { root.reply(); }
            }
            IconButton {
                icon: @image-url("../../icons/copy.svg");
                label: "Copy text";
                size: MellowComponent.action-bar-button-size;
                icon-color: MellowComponent.action-bar-icon;
                hover-icon-color: MellowComponent.action-bar-icon-hover;
                hover-background: MellowComponent.action-bar-button-background-hover;
                clicked => { root.copy-text(); }
            }
            if root.can-delete: IconButton {
                icon: @image-url("../../icons/trash.svg");
                label: "Delete";
                size: MellowComponent.action-bar-button-size;
                icon-color: MellowComponent.action-bar-icon;
                hover-icon-color: MellowComponent.action-bar-icon-danger-hover;
                hover-background: MellowComponent.action-bar-button-background-hover;
                clicked => { root.delete(self.is-shift-held-on-activation); }
            }
            IconButton {
                icon: @image-url("../../icons/dots-three.svg");
                label: "More";
                size: MellowComponent.action-bar-button-size;
                icon-color: MellowComponent.action-bar-icon;
                hover-icon-color: MellowComponent.action-bar-icon-hover;
                hover-background: MellowComponent.action-bar-button-background-hover;
            }
        }
    }
}

// "cancel" and "save" in the editor hint line: text-sized links in a full-height row.
component HintLink inherits Rectangle {
    in property <string> label;
    in property <string> accessible-name;
    callback activated();
    width: link-text.preferred-width;
    // WCAG 2.5.8 floor; Enter and Escape in the field are the primary way to save and cancel.
    min-height: MellowSize.hit-desktop-min;
    accessible-role: button;
    accessible-label: accessible-name;
    accessible-action-default => { root.activated(); }

    focus-scope := FocusScope {
        key-pressed(event) => {
            if event.text == " " || event.text == "\n" {
                root.activated();
                return accept;
            }
            reject
        }
    }
    touch := TouchArea {
        mouse-cursor: MouseCursor.pointer;
        clicked => { root.activated(); }
    }
    link-text := Text {
        text: label;
        color: MellowComponent.message-editor-hint-link;
        font-size: MellowType.message-subtext.font-size;
        vertical-alignment: center;
        accessible-role: none;
    }
    // Underline on hover, as links do on Discord.
    if touch.has-hover: Rectangle {
        y: (parent.height + link-text.preferred-height) / 2;
        height: MellowComponent.auth-card-link-underline-width;
        background: MellowComponent.message-editor-hint-link;
    }
    if focus-scope.has-focus: Rectangle {
        border-width: MellowComponent.focus-ring-width;
        border-color: MellowComponent.focus-ring-color;
        border-radius: MellowRadius.xs;
    }
}

// Inline editor that replaces a message body while it is edited, as on Discord.
component MessageEditor inherits VerticalLayout {
    // Held by ChatPane, not here: rebuilding the message rows recreates this editor, and the
    // user's typing must survive that.
    in-out property <string> draft;
    callback save(string);
    callback cancel();
    spacing: MellowComponent.message-editor-hint-gap;

    Rectangle {
        min-height: MellowComponent.composer-min-height;
        border-radius: MellowComponent.message-editor-radius;
        background: MellowComponent.message-editor-background;
        border-width: input.has-focus ? MellowComponent.focus-ring-width : 0px;
        border-color: MellowComponent.focus-ring-color;
        // Captures Enter before the multi-line field turns it into a new line; Shift+Enter still does.
        FocusScope {
            focus-on-click: false;
            focus-on-tab-navigation: false;
            capture-key-pressed(event) => {
                if event.text == Key.Escape {
                    root.cancel();
                    return accept;
                }
                if event.text == Key.Return && !event.modifiers.shift {
                    root.save(input.text);
                    return accept;
                }
                reject
            }
            HorizontalLayout {
                padding-left: MellowComponent.message-editor-padding-inline;
                padding-right: MellowComponent.message-editor-padding-inline;
                padding-top: MellowComponent.message-editor-padding-block;
                padding-bottom: MellowComponent.message-editor-padding-block;
                input := TextInput {
                    text <=> root.draft;
                    wrap: word-wrap;
                    single-line: false;
                    color: MellowComponent.message-editor-text;
                    font-size: MellowType.message.font-size;
                    selection-background-color: MellowComponent.message-selection-background;
                    accessible-label: "Edit message";
                    accessible-description: "Enter to save, Escape to cancel";
                    init => {
                        self.focus();
                        // Caret at the end, as on Discord. Offsets are UTF-8 bytes (up to 4 per
                        // character) and are clamped to the text length.
                        self.set-selection-offsets(self.text.character-count * 4, self.text.character-count * 4);
                    }
                }
            }
        }
    }
    HorizontalLayout {
        alignment: start;
        Text {
            text: "Esc to ";
            color: MellowComponent.message-editor-hint-text;
            font-size: MellowType.message-subtext.font-size;
            vertical-alignment: center;
            accessible-role: none;
        }
        HintLink {
            label: "cancel";
            accessible-name: "Cancel editing";
            activated => { root.cancel(); }
        }
        Text {
            text: " · Enter to ";
            color: MellowComponent.message-editor-hint-text;
            font-size: MellowType.message-subtext.font-size;
            vertical-alignment: center;
            accessible-role: none;
        }
        HintLink {
            label: "save";
            accessible-name: "Save changes";
            activated => { root.save(input.text); }
        }
    }
}

component MessageView inherits Rectangle {
    in property <MessageRow> message;
    in property <bool> is-text-selection-mode;
    in property <bool> is-editing;
    in property <bool> can-reply;
    in-out property <string> editing-draft;
    callback link-clicked(string);
    callback copy-text();
    callback reply();
    callback start-edit();
    callback save-edit(string);
    callback cancel-edit();
    // True when Shift was held: delete without confirmation.
    callback delete(bool);
    callback retry();
    callback discard();

    // Not set on rows the server has not stored: they cannot be edited, replied to or deleted there yet.
    property <bool> is-confirmed: message.delivery == MessageDelivery.sent;
    // Restarts when the rows are rebuilt (set_vec recreates them), which only delays the label again.
    property <bool> has-pending-label-delay-elapsed;
    property <MessageDelivery> delivery: message.delivery;
    changed delivery => { has-pending-label-delay-elapsed = false; }
    property <color> body-color: message.delivery == MessageDelivery.sending
        ? MellowComponent.message-pending-text : MellowComponent.message-body-text;

    // The content lives inside `touch`, so hovering text or links keeps the row hovered; the action
    // bar keeps it hovered too while the pointer is on its part above the row.
    property <bool> is-hovered: touch.has-hover || action-bar.is-hovered;

    background: message.mentions-current-user ? (is-hovered ? MellowComponent.mention-background-hover : MellowComponent.mention-background)
        : is-hovered || is-editing ? MellowComponent.message-background-hover : transparent;
    accessible-role: list-item;
    accessible-label: message.author + ", " + message.timestamp + ": " + message.body-plain
        + (message.is-edited ? " (edited)" : "");
    accessible-description: message.delivery == MessageDelivery.sending ? "Sending"
        : message.delivery == MessageDelivery.failed ? "Not sent. Retry or delete it." : "";

    Timer {
        interval: MellowMotion.delay-pending-label;
        running: root.delivery == MessageDelivery.sending && !root.has-pending-label-delay-elapsed;
        triggered => { root.has-pending-label-delay-elapsed = true; }
    }

    if message.mentions-current-user: Rectangle {
        x: 0;
        width: MellowComponent.mention-bar-width;
        background: MellowComponent.mention-bar-color;
    }

    touch := TouchArea {
        layout := VerticalLayout {
            padding-top: (message.starts-author-group ? MellowComponent.message-group-gap : 0px) + MellowComponent.message-padding-block;
            padding-bottom: MellowComponent.message-padding-block;
            padding-left: MellowComponent.message-gutter;
            padding-right: MellowComponent.message-padding-trailing;
            // The avatar sits outside the layout, so the row must still be tall enough to contain it.
            min-height: message.starts-author-group
                ? self.padding-top + MellowComponent.message-avatar-size + self.padding-bottom : 0px;

            if message.reply-preview != "": Text {
                text: "↪ " + message.reply-preview;
                color: MellowColor.text-muted;
                font-size: MellowType.body-sm.font-size;
                overflow: elide;
            }
            if message.starts-author-group: HorizontalLayout {
                spacing: MellowSpace.xs;
                alignment: start;
                Text {
                    text: message.author;
                    color: MellowComponent.message-author-text;
                    font-size: MellowType.message-author.font-size;
                    font-weight: MellowType.message-author.font-weight;
                }
                Text {
                    text: message.timestamp;
                    color: MellowComponent.message-timestamp-text;
                    font-size: MellowType.message-timestamp.font-size;
                    font-weight: MellowType.message-timestamp.font-weight;
                    vertical-alignment: center;
                }
            }
            // "(edited)" follows the last line rather than flowing inside it: the body is a
            // StyledText built in Rust, which Slint cannot append a differently styled run to.
            // A direct child of the vertical layout: inside a horizontal one, StyledText loses its
            // height-for-width and wrapped messages overlap the next row.
            if !is-editing && !is-text-selection-mode: StyledText {
                text: message.body;
                default-color: root.body-color;
                default-font-size: MellowType.message.font-size;
                link-color: MellowColor.text-link;
                link-clicked(url) => { root.link-clicked(url); }
            }
            // shortcut: on its own line, since StyledText cannot carry a differently styled suffix;
            // Discord puts it at the end of the last line.
            if !is-editing && message.is-edited: Text {
                text: "(edited)";
                color: MellowComponent.message-edited-text;
                font-size: MellowType.message-timestamp.font-size;
                font-weight: MellowType.message-timestamp.font-weight;
                // The row's accessible label already says "(edited)".
                accessible-role: none;
            }
            if !is-editing && is-text-selection-mode: TextInput {
                text: message.body-plain;
                read-only: true;
                wrap: word-wrap;
                color: root.body-color;
                font-size: MellowType.message.font-size;
                selection-background-color: MellowComponent.message-selection-background;
            }
            if message.delivery == MessageDelivery.sending && root.has-pending-label-delay-elapsed: Text {
                text: "Sending…";
                color: MellowComponent.message-pending-text;
                font-size: MellowType.message-subtext.font-size;
                // The row's accessible description already says "Sending".
                accessible-role: none;
            }
            if message.delivery == MessageDelivery.failed: HorizontalLayout {
                alignment: start;
                spacing: MellowSpace.xs;
                VerticalLayout {
                    alignment: center;
                    Image {
                        source: @image-url("../../icons/warning-circle.svg");
                        colorize: MellowComponent.message-failed-status-text;
                        width: MellowComponent.message-status-icon-size;
                        height: self.width;
                        accessible-role: none;
                    }
                }
                Text {
                    text: "Not sent.";
                    color: MellowComponent.message-failed-status-text;
                    font-size: MellowType.message-subtext.font-size;
                    vertical-alignment: center;
                    // The row's accessible description already says "Not sent".
                    accessible-role: none;
                }
                HintLink {
                    label: "Retry";
                    accessible-name: "Retry sending this message";
                    activated => { root.retry(); }
                }
                HintLink {
                    label: "Delete";
                    accessible-name: "Delete this unsent message";
                    activated => { root.discard(); }
                }
            }
            if is-editing: MessageEditor {
                draft <=> root.editing-draft;
                save(text) => { root.save-edit(text); }
                cancel => { root.cancel-edit(); }
            }
        }

        if message.starts-author-group: Avatar {
            x: MellowComponent.message-avatar-inset;
            y: layout.padding-top;
            initial: message.author-initial;
            size: MellowComponent.message-avatar-size;
        }
        if !message.starts-author-group && root.is-hovered: Text {
            x: 0;
            y: layout.padding-top;
            width: MellowComponent.message-gutter;
            text: message.short-time;
            color: MellowComponent.message-timestamp-text;
            font-size: MellowType.message-timestamp.font-size;
            horizontal-alignment: center;
        }
    }

    // Always instantiated: creating it on hover would destroy it under the pointer mid-click.
    // shortcut: shown on hover only; showing it on keyboard focus (DESIGN.md §5.4) needs focusable rows.
    action-bar := HoverActionBar {
        visible: root.is-hovered && root.is-confirmed;
        is-own: root.message.is-own;
        can-delete: root.message.can-delete;
        can-reply: root.can-reply;
        x: parent.width - self.width - MellowComponent.action-bar-offset-trailing;
        // The token is negative: the bar sits above the row's top edge, as on Discord.
        y: MellowComponent.action-bar-offset-top;
        edit => { root.start-edit(); }
        reply => { root.reply(); }
        copy-text => { root.copy-text(); }
        delete(skip-confirmation) => { root.delete(skip-confirmation); }
    }
}

// One static placeholder shaped like a group-start message (DESIGN.md §6.10): avatar circle, name
// bar, text bars. Decorative: the container announces "Loading messages" once.
component MessageSkeleton inherits Rectangle {
    // Fractions of the widest name bar, and of the text column for each line.
    in property <float> name-width-ratio;
    in property <[float]> line-width-ratios;

    layout := VerticalLayout {
        padding-top: MellowComponent.message-group-gap + MellowComponent.message-padding-block;
        padding-bottom: MellowComponent.message-padding-block;
        padding-left: MellowComponent.message-gutter;
        padding-right: MellowComponent.message-padding-trailing;
        // Each bar is centred in a line box as tall as a real line, so loaded messages take the same room.
        Rectangle {
            height: MellowType.message.line-height;
            Rectangle {
                x: 0;
                width: MellowComponent.message-skeleton-name-max-width * root.name-width-ratio;
                height: MellowComponent.message-skeleton-bar-height;
                border-radius: self.height / 2;
                background: MellowComponent.message-skeleton-fill;
            }
        }
        for ratio in root.line-width-ratios: Rectangle {
            height: MellowType.message.line-height;
            Rectangle {
                x: 0;
                width: parent.width * ratio;
                height: MellowComponent.message-skeleton-bar-height;
                border-radius: self.height / 2;
                background: MellowComponent.message-skeleton-fill;
            }
        }
    }
    Rectangle {
        x: MellowComponent.message-avatar-inset;
        y: layout.padding-top;
        width: MellowComponent.message-avatar-size;
        height: self.width;
        border-radius: self.width / 2;
        background: MellowComponent.message-skeleton-fill;
    }
}

// "You're viewing older messages" bar above the composer (DESIGN.md §5.4 "Unread divider and jump
// bars"). The whole bar is one button, as on Discord.
component JumpToPresentBar inherits Rectangle {
    // Messages that arrived in this channel since the reader scrolled away from the latest one.
    in property <int> new-message-count;
    callback jump();
    property <string> jump-label: new-message-count > 0 ? "Jump to present · " + new-message-count + " new" : "Jump to present";
    height: MellowComponent.jump-bar-height;
    border-top-left-radius: MellowComponent.jump-bar-radius;
    border-top-right-radius: MellowComponent.jump-bar-radius;
    background: touch.has-hover || focus-scope.has-focus ? MellowComponent.jump-bar-background-hover : MellowComponent.jump-bar-background;
    accessible-role: button;
    accessible-label: jump-label;
    accessible-description: "You're viewing older messages";
    accessible-action-default => { root.jump(); }
    forward-focus: focus-scope;

    focus-scope := FocusScope {
        key-pressed(event) => {
            if event.text == " " || event.text == "\n" {
                root.jump();
                return accept;
            }
            reject
        }
    }
    touch := TouchArea {
        mouse-cursor: MouseCursor.pointer;
        clicked => { root.jump(); }
    }
    HorizontalLayout {
        padding-left: MellowSpace.md;
        padding-right: MellowSpace.md;
        spacing: MellowSpace.xs;
        Text {
            text: "You're viewing older messages";
            color: MellowComponent.jump-bar-text;
            font-size: MellowType.body.font-size;
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: 1;
            accessible-role: none;
        }
        Text {
            text: root.jump-label;
            color: MellowComponent.jump-bar-text;
            font-size: MellowType.button.font-size;
            font-weight: MellowType.button.font-weight;
            vertical-alignment: center;
            accessible-role: none;
        }
    }
    // Inset, since the list clips it, and in the bar's text colour: the blue ring lacks 3:1 on apricot.
    if focus-scope.has-focus: Rectangle {
        border-width: MellowComponent.focus-ring-width;
        border-color: MellowComponent.jump-bar-text;
        border-top-left-radius: parent.border-top-left-radius;
        border-top-right-radius: parent.border-top-right-radius;
    }
}

// What sits above the oldest loaded message, or fills an empty list (DESIGN.md §5.4 "List states").
component HistoryStart inherits VerticalLayout {
    in property <HistoryStartState> state;
    in property <string> channel-name;
    in property <string> channel-topic;
    // An empty list shows 5 skeletons; above loaded messages, 3.
    in property <bool> is-list-empty;
    // Held by ChatPane: rows are recreated on every model reset and must not restart the delay.
    in property <bool> has-skeleton-delay-elapsed;
    in property <string> error-text;
    callback retry();
    // Above loaded rows, the height this takes changed by `delta` because the state changed; reported
    // once the new content is laid out, so the list can be scrolled before it is drawn.
    callback height-changed-above-rows(length);

    // Varied on purpose, so the placeholders read as messages rather than a grid.
    property <[{ name: float, lines: [float] }]> skeleton-shapes: [
        { name: 0.75, lines: [0.72, 0.46] },
        { name: 0.5, lines: [0.58] },
        { name: 0.9, lines: [0.86, 0.78, 0.34] },
        { name: 0.6, lines: [0.4] },
        { name: 0.8, lines: [0.66, 0.52] },
    ];

    // What is drawn, as far as its height goes: nothing, skeletons, the error or the hero.
    property <int> drawn-content: root.state == HistoryStartState.loading ? (root.has-skeleton-delay-elapsed ? 1 : 0)
        : root.state == HistoryStartState.failed ? 2 : root.state == HistoryStartState.channel-start ? 3 : 0;
    // Only a height change that comes with new drawn content moves the reader's rows; others
    // (creation, width) do not. Compared rather than flagged from `changed drawn-content`, since
    // Slint does not order the two change handlers.
    property <length> measured-height;
    property <int> measured-drawn-content;
    init => {
        root.measured-height = root.height;
        root.measured-drawn-content = root.drawn-content;
    }
    changed height => {
        if root.drawn-content != root.measured-drawn-content && !root.is-list-empty {
            root.height-changed-above-rows(root.height - root.measured-height);
        }
        root.measured-height = root.height;
        root.measured-drawn-content = root.drawn-content;
    }

    if root.state == HistoryStartState.loading && root.has-skeleton-delay-elapsed: VerticalLayout {
        accessible-role: progress-indicator;
        accessible-label: "Loading messages";
        for index in root.is-list-empty ? 5 : 3: MessageSkeleton {
            name-width-ratio: root.skeleton-shapes[index].name;
            line-width-ratios: root.skeleton-shapes[index].lines;
        }
    }

    if root.state == HistoryStartState.failed: HorizontalLayout {
        padding-top: MellowComponent.message-group-gap;
        // Above loaded rows, the first message's group gap already spaces it.
        padding-bottom: root.is-list-empty ? MellowComponent.message-group-gap : 0px;
        padding-left: MellowComponent.message-gutter;
        padding-right: MellowComponent.message-padding-trailing;
        spacing: MellowComponent.message-history-error-gap;
        alignment: start;
        VerticalLayout {
            alignment: center;
            Image {
                source: @image-url("../../icons/warning-circle.svg");
                colorize: MellowComponent.message-history-error-icon;
                width: MellowComponent.message-history-error-icon-size;
                height: self.width;
                accessible-role: none;
            }
        }
        Text {
            text: root.error-text;
            color: MellowComponent.message-history-error-text;
            font-size: MellowType.message.font-size;
            vertical-alignment: center;
            // Announced by ChatPane's live region, which outlives this row.
            accessible-role: none;
        }
        Button {
            label: "Try again";
            accessible-description: root.error-text;
            clicked => { root.retry(); }
        }
    }

    // Discord's channel-start hero, aligned on the avatar column. No "Edit channel" until channel editing exists.
    if root.state == HistoryStartState.channel-start: VerticalLayout {
        padding-top: MellowComponent.message-channel-start-padding-block;
        padding-bottom: MellowComponent.message-channel-start-padding-block;
        padding-left: MellowComponent.message-avatar-inset;
        padding-right: MellowComponent.message-padding-trailing;
        spacing: MellowComponent.message-channel-start-gap;
        accessible-role: groupbox;
        accessible-label: "Start of #" + root.channel-name;
        HorizontalLayout {
            alignment: start;
            Rectangle {
                width: MellowComponent.message-channel-start-icon-circle-size;
                height: self.width;
                border-radius: self.width / 2;
                background: MellowComponent.message-channel-start-icon-background;
                Image {
                    source: @image-url("../../icons/hash.svg");
                    colorize: MellowComponent.message-channel-start-icon;
                    width: MellowComponent.message-channel-start-icon-size;
                    height: self.width;
                    accessible-role: none;
                }
            }
        }
        Text {
            text: "Welcome to #" + root.channel-name;
            color: MellowComponent.message-channel-start-title-text;
            font-size: MellowType.display.font-size;
            font-weight: MellowType.display.font-weight;
            wrap: word-wrap;
            accessible-role: text;
        }
        Text {
            text: "This is the start of the #" + root.channel-name + " channel.";
            color: MellowComponent.message-channel-start-description-text;
            font-size: MellowType.message.font-size;
            wrap: word-wrap;
            accessible-role: text;
        }
        if root.channel-topic != "": Text {
            text: root.channel-topic;
            color: MellowComponent.message-channel-start-description-text;
            font-size: MellowType.message.font-size;
            wrap: word-wrap;
            accessible-role: text;
        }
    }
}

export component ChatPane inherits Rectangle {
    in property <string> channel-name;
    in property <string> channel-topic;
    in property <[MessageRow]> messages;
    in property <bool> is-text-selection-mode;
    in property <string> latest-announcement;
    in-out property <string> composer-text;
    in-out property <bool> is-member-list-visible;
    // Non-empty while replying: shows the "Replying to" bar above the composer.
    in property <string> replying-to-author;
    // False where the user lacks Send Messages: a notice replaces the composer and replies are hidden.
    in property <bool> can-send-messages: true;
    // Never while the user cannot send, whatever reply state Rust kept.
    property <bool> is-replying: replying-to-author != "" && can-send-messages;
    // Row shown with the inline editor, or -1.
    in-out property <int> editing-message-index: -1;
    // The editor's text, set from the message when editing starts.
    in-out property <string> editing-message-draft;
    // Row whose deletion awaits confirmation in the dialog (drawn by AppWindow), or -1.
    in-out property <int> deleting-message-index: -1;
    // Non-empty after a failed edit or delete: shown and announced above the composer.
    in property <string> message-action-error;
    callback send-message(string);
    callback link-clicked(string);
    callback copy-message-text(int);
    callback reply-to-message(int);
    callback cancel-reply();
    callback save-message-edit(int, string);
    callback edit-last-own-message();
    callback delete-message(int);
    // Outbox rows: send a failed message again, or drop it locally (only from this app: a lost
    // answer may hide a send the server did store).
    callback retry-message(int);
    callback discard-failed-message(int);
    // The reader scrolled near the top of the loaded messages.
    callback load-older-messages();
    in property <HistoryStartState> history-start-state;
    // "Try again" after a failed history load, initial or older.
    callback retry-loading-history();

    // Typing goes straight into the reply, as on Discord.
    changed is-replying => {
        if self.is-replying {
            root.focus-composer();
        }
    }

    // True while the newest message is in view; new messages and row-height refinements then keep
    // the list anchored to the bottom, as on Discord. Scrolling up releases it.
    property <bool> is-pinned-to-latest-message: true;
    // How far above the bottom the pinned list stays: zero, except while older messages are
    // prepended, so the rows being read do not move.
    property <length> pinned-distance-from-latest-message: 0px;
    property <length> latest-message-content-y: min(0px, message-list.visible-height - message-list.content-height);
    property <length> pinned-content-y: latest-message-content-y + pinned-distance-from-latest-message;

    public function scroll-to-latest-message() {
        is-pinned-to-latest-message = true;
        pinned-distance-from-latest-message = 0px;
        message-list.content-y = latest-message-content-y;
        is-viewing-older-messages = false;
        new-message-count-while-viewing-older = 0;
    }

    // Not is-pinned-to-latest-message: pinning also holds the rows being read while older history
    // is prepended, far from the latest message.
    property <bool> is-viewing-older-messages;
    property <int> new-message-count-while-viewing-older;
    // Rust calls this for each message arriving in the open channel; the bar counts them.
    public function note-new-message() {
        if is-viewing-older-messages {
            new-message-count-while-viewing-older += 1;
        }
    }

    // Checked on every geometry change, not only user scrolls: Slint does not report a flick that
    // coasts to the top, and a reader already at the top cannot scroll further to retry. Rust
    // asks for one page at a time, so repeated calls are cheap.
    function load-older-messages-when-near-top() {
        if message-list.content-y >= -MellowComponent.message-history-load-distance {
            root.load-older-messages();
        }
    }

    // Called before rows are added above the visible ones; the next user scroll releases it.
    public function keep-distance-from-latest-message() {
        pinned-distance-from-latest-message = message-list.content-y - latest-message-content-y;
        is-pinned-to-latest-message = true;
    }

    // Skeletons wait for motion.delay-skeleton, so short loads show nothing. Kept here rather than in
    // the row that draws them: rebuilding the rows must not restart the delay.
    property <bool> has-history-skeleton-delay-elapsed;
    changed history-start-state => { has-history-skeleton-delay-elapsed = false; }
    property <string> history-error-text: messages.length > 0 ? "Couldn't load older messages."
        : "Couldn't load messages in #" + channel-name + ".";
    Timer {
        interval: MellowMotion.delay-skeleton;
        running: root.history-start-state == HistoryStartState.loading && !root.has-history-skeleton-delay-elapsed;
        triggered => { root.has-history-skeleton-delay-elapsed = true; }
    }

    // Scrolls up by `distance`; returns false once the top is reached (used by the scroll benchmark).
    public function scroll-up-by(distance: length) -> bool {
        is-pinned-to-latest-message = false;
        message-list.content-y = min(0px, message-list.content-y + distance);
        is-viewing-older-messages = message-list.content-y > latest-message-content-y + 1px;
        message-list.content-y < 0px
    }

    // `scrolled` reads the position a wheel or flick animation starts from, so a scroll that coasts
    // to the bottom is released there; this pins it again once it arrives. Only at distance zero,
    // so the row 0 trap (pinning near the top) cannot occur.
    function pin-when-latest-message-reached() {
        if !is-pinned-to-latest-message && message-list.content-y <= latest-message-content-y + 1px {
            is-pinned-to-latest-message = true;
            pinned-distance-from-latest-message = 0px;
            is-viewing-older-messages = false;
            new-message-count-while-viewing-older = 0;
        }
    }

    background: MellowColor.surface-chat;
    min-width: MellowSize.chat-min-width;
    // Every path that focuses the composer comes here: without Send Messages it is hidden and
    // must not take focus.
    public function focus-composer() {
        if root.can-send-messages {
            composer.focus();
        }
    }
    // Row 0's history start changed height by `delta` while row 0 is on screen (only then is it
    // instantiated, and only then does its height move the rows being read): scroll by as much.
    // Not keep-distance-from-latest-message: pinning near the top, where ListView estimates the
    // content height from the visible rows, makes the estimate and the position chase each other.
    // A list pinned to the latest message re-anchors to the bottom by itself.
    function keep-rows-in-place-after-history-start-change(delta: length) {
        if !root.is-pinned-to-latest-message {
            message-list.content-y = min(0px, message-list.content-y - delta);
        }
    }
    // The bar disappears once at the latest message, so focus goes to the composer, as on Discord.
    function jump-to-present() {
        root.scroll-to-latest-message();
        root.focus-composer();
    }
    // "Try again" disappears with the failed state, so focus goes back to the composer.
    function retry-loading-history-and-focus-composer() {
        root.retry-loading-history();
        root.focus-composer();
    }

    VerticalLayout {
        Rectangle {
            height: MellowComponent.chat-header-height;
            background: MellowComponent.chat-header-background;
            HorizontalLayout {
                padding-left: MellowComponent.chat-header-padding-inline;
                padding-right: MellowComponent.chat-header-padding-inline;
                spacing: MellowSpace.xs;
                VerticalLayout {
                    alignment: center;
                    Image {
                        source: @image-url("../../icons/hash.svg");
                        colorize: MellowComponent.chat-header-icon;
                        width: MellowComponent.chat-header-icon-size;
                        height: self.width;
                        accessible-role: none;
                    }
                }
                Text {
                    text: channel-name;
                    color: MellowComponent.chat-header-name-text;
                    font-size: MellowType.heading-md.font-size;
                    font-weight: MellowType.heading-md.font-weight;
                    vertical-alignment: center;
                    accessible-role: text;
                }
                if channel-topic != "": Rectangle {
                    width: 1px;
                    height: MellowComponent.chat-header-divider-height;
                    background: MellowColor.border-divider;
                }
                Text {
                    text: channel-topic;
                    color: MellowComponent.chat-header-topic-text;
                    font-size: MellowType.body-sm.font-size;
                    vertical-alignment: center;
                    overflow: elide;
                    horizontal-stretch: 1;
                }
                VerticalLayout {
                    alignment: center;
                    IconButton {
                        icon: @image-url("../../icons/users.svg");
                        label: is-member-list-visible ? "Hide member list" : "Show member list";
                        size: MellowComponent.chat-header-button-size;
                        icon-color: is-member-list-visible ? MellowColor.text-heading : MellowComponent.chat-header-icon;
                        hover-background: MellowColor.state-hover;
                        clicked => { root.is-member-list-visible = !root.is-member-list-visible; }
                    }
                }
            }
            Rectangle {
                y: parent.height - 1px;
                height: 1px;
                background: MellowColor.border-divider;
            }
        }

        // The list and, while it has no rows, the state that fills it (DESIGN.md §5.4 "List states").
        Rectangle {
            vertical-stretch: 1;
            clip: true;
            message-list := ListView {
                width: 100%;
                height: 100%;
                // ListView estimates unseen row heights and refines them while rendering, which moves
                // content-y and content-height by itself; while pinned, snap back to the bottom.
                changed content-height => {
                    root.pin-when-latest-message-reached();
                    if root.is-pinned-to-latest-message {
                        self.content-y = root.pinned-content-y;
                    }
                    root.load-older-messages-when-near-top();
                }
                changed visible-height => {
                    root.pin-when-latest-message-reached();
                    if root.is-pinned-to-latest-message {
                        self.content-y = root.pinned-content-y;
                    }
                }
                changed content-y => {
                    root.pin-when-latest-message-reached();
                    if root.is-pinned-to-latest-message && self.content-y != root.pinned-content-y {
                        self.content-y = root.pinned-content-y;
                    }
                    root.load-older-messages-when-near-top();
                }
                // Only user scrolling (wheel, drag, scrollbar) decides whether the list stays pinned.
                scrolled => {
                    root.is-pinned-to-latest-message = self.content-y <= root.latest-message-content-y + 1px;
                    root.pinned-distance-from-latest-message = 0px;
                    root.is-viewing-older-messages = !root.is-pinned-to-latest-message;
                    if root.is-pinned-to-latest-message {
                        root.new-message-count-while-viewing-older = 0;
                    }
                    root.load-older-messages-when-near-top();
                }
                accessible-role: list;
                accessible-label: "Messages in " + channel-name;
                // Row 0 carries the history start above its message, so it scrolls with the rows and
                // row indices stay those of the model, which Rust addresses rows by.
                for message[index] in messages: VerticalLayout {
                    // Always there on row 0, empty when unknown, so it can report every height change.
                    if index == 0: HistoryStart {
                        state: root.history-start-state;
                        channel-name: root.channel-name;
                        channel-topic: root.channel-topic;
                        is-list-empty: false;
                        has-skeleton-delay-elapsed: root.has-history-skeleton-delay-elapsed;
                        error-text: root.history-error-text;
                        retry => { root.retry-loading-history-and-focus-composer(); }
                        height-changed-above-rows(delta) => { root.keep-rows-in-place-after-history-start-change(delta); }
                    }
                    MessageView {
                        message: message;
                        is-text-selection-mode: root.is-text-selection-mode;
                        can-reply: root.can-send-messages;
                        // Outbox rows never show the editor, whatever index Rust sets.
                        is-editing: index == root.editing-message-index && message.delivery == MessageDelivery.sent;
                        editing-draft <=> root.editing-message-draft;
                        link-clicked(url) => { root.link-clicked(url); }
                        copy-text => { root.copy-message-text(index); }
                        reply => { root.reply-to-message(index); }
                        start-edit => {
                            root.editing-message-draft = message.body-plain;
                            root.editing-message-index = index;
                        }
                        save-edit(text) => {
                            root.editing-message-index = -1;
                            // Saving an empty message asks to delete it, when allowed; an unchanged one is
                            // not re-sent (DESIGN.md §5.5).
                            if text == "" && message.can-delete {
                                root.deleting-message-index = index;
                            } else {
                                if text != "" && text != message.body-plain {
                                    root.save-message-edit(index, text);
                                }
                                root.focus-composer();
                            }
                        }
                        cancel-edit => {
                            root.editing-message-index = -1;
                            root.focus-composer();
                        }
                        delete(skip-confirmation) => {
                            if skip-confirmation {
                                root.delete-message(index);
                            } else {
                                root.deleting-message-index = index;
                            }
                        }
                        // Both links disappear with the failed state, so focus goes back to the composer.
                        retry => {
                            root.retry-message(index);
                            root.focus-composer();
                        }
                        discard => {
                            root.discard-failed-message(index);
                            root.focus-composer();
                        }
                    }
                }
            }
            // Bottom-aligned, as Discord fills an empty channel from the composer up.
            if messages.length == 0 && root.history-start-state != HistoryStartState.unknown: VerticalLayout {
                alignment: end;
                HistoryStart {
                    state: root.history-start-state;
                    channel-name: root.channel-name;
                    channel-topic: root.channel-topic;
                    is-list-empty: true;
                    has-skeleton-delay-elapsed: root.has-history-skeleton-delay-elapsed;
                    error-text: root.history-error-text;
                    retry => { root.retry-loading-history-and-focus-composer(); }
                }
            }
            // Over the list rather than above it: taking layout height would resize the list and move
            // the rows being read.
            if root.is-viewing-older-messages: JumpToPresentBar {
                x: MellowComponent.composer-margin-inline;
                y: parent.height - self.height;
                width: parent.width - 2 * MellowComponent.composer-margin-inline;
                new-message-count: root.new-message-count-while-viewing-older;
                jump => { root.jump-to-present(); }
            }
        }

        // History load failures are announced here: the row showing them can be scrolled out and recycled.
        Text {
            height: 0px;
            text: root.history-start-state == HistoryStartState.failed ? root.history-error-text : "";
            accessible-role: text;
            accessible-live-region: polite;
        }

        // Screen readers announce new messages through this live region, not by re-reading the list.
        Text {
            height: 0px;
            text: latest-announcement;
            accessible-role: text;
            accessible-live-region: polite;
        }
        // Edit and delete failures are announced at once: they answer an action the user just took.
        Text {
            height: 0px;
            text: message-action-error;
            accessible-role: text;
            accessible-live-region: assertive;
        }

        if message-action-error != "": HorizontalLayout {
            padding-left: MellowComponent.composer-margin-inline;
            padding-right: MellowComponent.composer-margin-inline;
            padding-bottom: MellowComponent.composer-error-padding-block;
            Text {
                text: message-action-error;
                color: MellowComponent.composer-error-text;
                font-size: MellowType.body.font-size;
                wrap: word-wrap;
                // Announced through the live region above instead.
                accessible-role: none;
            }
        }

        VerticalLayout {
            padding-left: MellowComponent.composer-margin-inline;
            padding-right: MellowComponent.composer-margin-inline;
            if root.is-replying: Rectangle {
                min-height: MellowComponent.composer-reply-bar-min-height;
                border-top-left-radius: MellowComponent.composer-radius;
                border-top-right-radius: MellowComponent.composer-radius;
                background: MellowComponent.composer-reply-bar-background;
                accessible-role: groupbox;
                accessible-label: "Replying to " + replying-to-author;
                HorizontalLayout {
                    padding-left: MellowComponent.composer-reply-bar-padding-inline;
                    // The close button's own padding already spaces its icon from the edge.
                    padding-right: MellowSpace.space-2xs;
                    Text {
                        text: "Replying to ";
                        color: MellowComponent.composer-reply-bar-text;
                        font-size: MellowType.body.font-size;
                        vertical-alignment: center;
                        accessible-role: none;
                    }
                    Text {
                        text: replying-to-author;
                        color: MellowComponent.composer-reply-bar-author-text;
                        font-size: MellowType.body.font-size;
                        font-weight: MellowType.user-panel-name.font-weight;
                        vertical-alignment: center;
                        overflow: elide;
                        horizontal-stretch: 1;
                        accessible-role: none;
                    }
                    VerticalLayout {
                        alignment: center;
                        IconButton {
                            icon: @image-url("../../icons/x-circle.svg");
                            label: "Cancel reply";
                            size: MellowComponent.composer-reply-bar-button-size;
                            icon-color: MellowComponent.composer-reply-bar-icon;
                            hover-icon-color: MellowComponent.composer-icon-hover;
                            hover-background: MellowComponent.composer-reply-bar-button-background-hover;
                            clicked => {
                                root.cancel-reply();
                                root.focus-composer();
                            }
                        }
                    }
                }
            }
            Rectangle {
                min-height: root.can-send-messages ? MellowComponent.composer-min-height
                    : max(MellowComponent.composer-min-height, locked-notice.preferred-height + 2 * MellowSpace.xs);
                // The single-line field used to cap this height; the hidden one no longer does, and the
                // read-only notice would share the list's stretch.
                vertical-stretch: 0;
                // Square top corners while the reply bar sits on top, as on Discord.
                border-top-left-radius: root.is-replying ? 0px : MellowComponent.composer-radius;
                border-top-right-radius: self.border-top-left-radius;
                border-bottom-left-radius: MellowComponent.composer-radius;
                border-bottom-right-radius: MellowComponent.composer-radius;
                background: MellowComponent.composer-background;
                // Discord shows no ring here; WCAG 2.4.7 needs one for keyboard users (ADR-0012).
                border-width: composer.has-focus ? MellowComponent.focus-ring-width : 0px;
                border-color: MellowComponent.focus-ring-color;
                // Discord's wording, in the field's place: read by screen readers but never focused, so
                // nothing suggests typing there. Placed by hand with a fixed width, since neither a
                // Rectangle nor a horizontal layout grows with wrapped text: min-height above reads
                // its wrapped height instead.
                locked-notice := Text {
                    visible: !root.can-send-messages;
                    x: MellowComponent.composer-padding-inline;
                    width: parent.width - 2 * MellowComponent.composer-padding-inline;
                    height: parent.height;
                    text: "You do not have permission to send messages in this channel.";
                    color: MellowComponent.composer-locked-text;
                    font-size: MellowType.message.font-size;
                    vertical-alignment: center;
                    wrap: word-wrap;
                    accessible-role: text;
                }
                HorizontalLayout {
                    padding-left: MellowComponent.composer-padding-inline;
                    padding-right: MellowComponent.composer-padding-inline;
                    spacing: MellowComponent.composer-padding-inline;
                    if root.can-send-messages: VerticalLayout {
                        alignment: center;
                        IconButton {
                            icon: @image-url("../../icons/plus-circle.svg");
                            label: "Upload a file";
                            size: MellowComponent.composer-icon-size;
                            icon-color: MellowComponent.composer-icon;
                            hover-background: transparent;
                        }
                    }
                    Rectangle {
                        horizontal-stretch: 1;
                        if root.can-send-messages && composer.text == "": Text {
                            x: 0;
                            text: "Message #" + channel-name;
                            color: MellowComponent.composer-placeholder;
                            font-size: MellowType.message.font-size;
                            vertical-alignment: center;
                            accessible-role: none;
                        }
                        // Escape and Up are captured before the field can use them. Kept, hidden, while
                        // the user cannot send, so `composer` stays addressable and its draft survives.
                        FocusScope {
                            visible: root.can-send-messages;
                            focus-on-click: false;
                            focus-on-tab-navigation: false;
                            capture-key-pressed(event) => {
                                if event.text == Key.Escape && root.is-replying {
                                    root.cancel-reply();
                                    return accept;
                                }
                                if event.text == Key.Escape && root.is-viewing-older-messages {
                                    root.jump-to-present();
                                    return accept;
                                }
                                if event.text == Key.UpArrow && composer.text == "" {
                                    root.edit-last-own-message();
                                    return accept;
                                }
                                reject
                            }
                            composer := TextInput {
                                text <=> root.composer-text;
                                color: MellowComponent.composer-text;
                                font-size: MellowType.message.font-size;
                                vertical-alignment: center;
                                single-line: true;
                                enabled: root.can-send-messages;
                                accessible-label: "Message #" + channel-name;
                                accessible-description: root.is-replying
                                    ? "Replying to " + root.replying-to-author + ". Escape cancels the reply." : "";
                                accepted => {
                                    if self.text != "" {
                                        root.send-message(self.text);
                                        self.text = "";
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
        // Reserved band for "Aurore is typing…", as on Discord.
        Rectangle { height: MellowComponent.composer-typing-height; }
    }
}
