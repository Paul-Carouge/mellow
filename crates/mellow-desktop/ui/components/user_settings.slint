import { ScrollView } from "std-widgets.slint";
import { MellowColor, MellowComponent, MellowFont, MellowMotion, MellowRadius, MellowSize, MellowSpace, MellowType } from "../tokens.slint";
import { MotionPreference, ThemeChoice } from "../preferences.slint";
import { Button, TextField } from "primitives.slint";

// Where the app's self-update stands (DESIGN.md §5.9, About); set from Rust.
export enum UpdateStatus { unknown, checking, up-to-date, available, downloading, ready-to-restart, failed, unsupported }

// One item of the settings navigation (DESIGN.md §6.43). The danger item ("Sign out") fills red on
// hover like danger menu items; keyboard focus shows only the ring, as in context menus.
export component SettingsNavItem inherits Rectangle {
    in property <string> label;
    in property <bool> is-selected;
    in property <bool> is-danger;
    callback activated();
    height: MellowComponent.settings-nav-item-height;
    border-radius: MellowComponent.settings-nav-item-radius;
    forward-focus: focus-scope;
    accessible-role: tab;
    accessible-label: label;
    accessible-item-selected: is-selected;
    accessible-action-default => { root.activated(); }

    property <bool> is-highlighted: touch.has-hover || (focus-scope.has-focus && !is-danger);
    background: is-danger ? (touch.has-hover ? MellowComponent.settings-nav-danger-background-hover : transparent)
        : is-selected ? MellowComponent.settings-nav-item-background-selected
        : is-highlighted ? MellowComponent.settings-nav-item-background-hover : transparent;
    border-width: focus-scope.has-focus ? MellowComponent.focus-ring-width : 0px;
    border-color: MellowComponent.focus-ring-color;

    focus-scope := FocusScope {
        key-pressed(event) => {
            if event.text == " " || event.text == "\n" {
                root.activated();
                return accept;
            }
            reject
        }
    }
    touch := TouchArea {
        mouse-cursor: MouseCursor.pointer;
        clicked => { root.activated(); }
    }
    Text {
        x: MellowComponent.settings-nav-item-padding-inline;
        width: parent.width - 2 * MellowComponent.settings-nav-item-padding-inline;
        text: label;
        color: is-danger ? (touch.has-hover ? MellowComponent.settings-nav-danger-text-hover : MellowComponent.settings-nav-danger-text)
            : is-selected ? MellowComponent.settings-nav-item-text-selected
            : is-highlighted ? MellowComponent.settings-nav-item-text-hover : MellowComponent.settings-nav-item-text;
        font-size: MellowType.channel-name.font-size;
        font-weight: MellowType.channel-name.font-weight;
        vertical-alignment: center;
        overflow: elide;
        accessible-role: none;
    }
}

// Section label, in sentence case (ADR-0022).
export component SectionLabel inherits Text {
    in property <string> label;
    text: label;
    color: MellowComponent.settings-section-label-text;
    font-size: MellowType.category.font-size;
    font-weight: MellowType.category.font-weight;
    letter-spacing: MellowType.category.letter-spacing;
    overflow: elide;
}

// Discord's round close button with "Esc" under it, at the trailing top of the page.
export component CloseButton inherits VerticalLayout {
    callback clicked();
    spacing: MellowSpace.space-2xs;
    alignment: start;

    property <bool> is-highlighted: touch.has-hover || focus-scope.has-focus;
    Rectangle {
        width: MellowComponent.settings-close-button-size;
        height: self.width;
        border-radius: self.width / 2;
        border-width: MellowComponent.settings-close-border-width;
        border-color: root.is-highlighted ? MellowComponent.settings-close-border-hover : MellowComponent.settings-close-border;
        background: root.is-highlighted ? MellowComponent.settings-close-background-hover : transparent;
        accessible-role: button;
        accessible-label: "Close settings";
        accessible-description: "Esc";
        accessible-action-default => { root.clicked(); }
        forward-focus: focus-scope;

        focus-scope := FocusScope {
            key-pressed(event) => {
                if event.text == " " || event.text == "\n" {
                    root.clicked();
                    return accept;
                }
                reject
            }
        }
        touch := TouchArea {
            mouse-cursor: MouseCursor.pointer;
            clicked => { root.clicked(); }
        }
        Image {
            source: @image-url("../../icons/x.svg");
            colorize: root.is-highlighted ? MellowComponent.settings-close-icon-hover : MellowComponent.settings-close-icon;
            width: MellowComponent.settings-close-icon-size;
            height: self.width;
            accessible-role: none;
        }
        // Outset ring, so it does not merge with the button's own circle.
        if focus-scope.has-focus: Rectangle {
            x: -(MellowComponent.focus-ring-offset + MellowComponent.focus-ring-width);
            y: self.x;
            width: parent.width - 2 * self.x;
            height: self.width;
            border-radius: self.width / 2;
            border-width: MellowComponent.focus-ring-width;
            border-color: MellowComponent.focus-ring-color;
        }
    }
    Text {
        text: "Esc";
        color: MellowColor.text-muted;
        font-size: MellowType.body-sm.font-size;
        font-weight: MellowFont.weight-semibold;
        horizontal-alignment: center;
        // The button's description carries it.
        accessible-role: none;
    }
}

// Which page the settings show.
enum SettingsSection { account, appearance, about }

// One choice of a segmented control (DESIGN.md §5.9, Appearance): the chosen one is lifted onto the
// sheet's colour.
component SegmentedChoice inherits Rectangle {
    in property <string> label;
    in property <bool> is-chosen;
    callback chosen();
    height: MellowComponent.settings-close-button-size;
    width: choice-text.preferred-width + 2 * MellowSpace.md;
    border-radius: MellowRadius.sm;
    background: is-chosen ? MellowColor.surface-chat : transparent;
    accessible-role: radio-button;
    accessible-label: label;
    accessible-checkable: true;
    accessible-checked: is-chosen;
    accessible-action-default => { root.chosen(); }
    forward-focus: focus-scope;
    // `motion.easing.standard`; colour only, so reduced motion keeps it.
    animate background { duration: MellowMotion.duration-fast; easing: cubic-bezier(0.2, 0, 0, 1); }

    focus-scope := FocusScope {
        key-pressed(event) => {
            if event.text == " " || event.text == "\n" {
                root.chosen();
                return accept;
            }
            reject
        }
    }
    touch := TouchArea {
        mouse-cursor: MouseCursor.pointer;
        clicked => { root.chosen(); }
    }
    choice-text := Text {
        text: root.label;
        color: root.is-chosen ? MellowColor.text-heading : touch.has-hover ? MellowColor.text-normal : MellowColor.text-secondary;
        font-size: MellowType.body-lg.font-size;
        vertical-alignment: center;
        accessible-role: none;
        animate color { duration: MellowMotion.duration-fast; easing: cubic-bezier(0.2, 0, 0, 1); }
    }
    if focus-scope.has-focus: Rectangle {
        border-width: MellowComponent.focus-ring-width;
        border-color: MellowComponent.focus-ring-color;
        border-radius: parent.border-radius;
    }
}

// The segmented control's track.
component Segmented inherits Rectangle {
    in property <string> label;
    border-radius: MellowRadius.md;
    background: MellowColor.surface-input;
    accessible-role: groupbox;
    accessible-label: label;
    HorizontalLayout {
        padding: MellowSpace.space-2xs;
        spacing: MellowSpace.space-2xs;
        @children
    }
}

// A labelled settings section: label, optional description, then its control.
component SettingsSectionBlock inherits VerticalLayout {
    in property <string> label;
    in property <string> description;
    spacing: MellowSpace.sm;
    alignment: start;
    SectionLabel {
        label: root.label;
        color: MellowColor.text-muted;
    }
    if root.description != "": Text {
        text: root.description;
        color: MellowColor.text-secondary;
        font-size: MellowType.body.font-size;
        wrap: word-wrap;
    }
    HorizontalLayout {
        alignment: start;
        @children
    }
}

// Which My Account form is open; only one at a time, so an error always belongs to the open one.
enum AccountEditor { none, display-name, username, password }

// A 1 px divider between navigation groups, as on Discord.
component NavSeparator inherits Rectangle {
    height: 1px + 2 * MellowComponent.settings-nav-separator-margin-block;
    Rectangle {
        x: MellowComponent.settings-nav-separator-margin-inline;
        width: parent.width - 2 * MellowComponent.settings-nav-separator-margin-inline;
        height: 1px;
        background: MellowComponent.settings-nav-separator;
    }
}

// A navigation group: its label, then its items. The tab list's label already says it.
component NavGroup inherits Rectangle {
    in property <string> label;
    accessible-role: tab-list;
    accessible-label: label;
    VerticalLayout {
        spacing: MellowComponent.settings-nav-item-gap;
        HorizontalLayout {
            padding-left: MellowComponent.settings-nav-section-padding-inline;
            padding-right: MellowComponent.settings-nav-section-padding-inline;
            padding-top: MellowComponent.settings-nav-section-padding-block;
            padding-bottom: MellowComponent.settings-nav-section-padding-block;
            SectionLabel {
                label: root.label;
                color: MellowComponent.settings-nav-section-text;
                accessible-role: none;
            }
        }
        @children
    }
}

// A sentence after an icon, so success and failure never rely on colour alone. Screen readers hear
// it through the screen's live regions, so the visible copy is not read twice.
component StatusLine inherits HorizontalLayout {
    in property <string> text;
    in property <bool> is-error;
    spacing: MellowComponent.settings-error-icon-gap;
    VerticalLayout {
        alignment: start;
        Image {
            source: root.is-error ? @image-url("../../icons/warning-circle.svg") : @image-url("../../icons/check.svg");
            colorize: root.is-error ? MellowComponent.settings-error-icon : MellowComponent.settings-notice-text;
            width: MellowComponent.settings-error-icon-size;
            height: self.width;
            accessible-role: none;
        }
    }
    Text {
        text: root.text;
        color: root.is-error ? MellowComponent.settings-error-text : MellowComponent.settings-notice-text;
        font-size: MellowType.body.font-size;
        wrap: word-wrap;
        horizontal-stretch: 1;
        accessible-role: none;
    }
}

// Label and value of one account field.
component AccountFieldValue inherits VerticalLayout {
    in property <string> label;
    in property <string> value;
    spacing: MellowComponent.settings-account-value-gap;
    SectionLabel {
        label: root.label;
    }
    Text {
        text: root.value;
        color: MellowComponent.settings-account-value-text;
        font-size: MellowType.body-lg.font-size;
        wrap: word-wrap;
    }
}

// An editable account field with its Edit button at the trailing end, as on Discord.
component AccountFieldRow inherits HorizontalLayout {
    in property <string> label;
    in property <string> value;
    // "Edit display name": "Edit" alone does not say which field for screen readers.
    in property <string> edit-label;
    in property <bool> is-edit-enabled;
    // True when this row comes back after its form closed: focus returns to its Edit button.
    in property <bool> should-take-focus;
    callback edit();
    spacing: MellowComponent.settings-account-button-gap;

    init => {
        if should-take-focus {
            edit-button.focus();
        }
    }

    AccountFieldValue {
        horizontal-stretch: 1;
        label: root.label;
        value: root.value;
    }
    VerticalLayout {
        alignment: center;
        edit-button := Button {
            label: "Edit";
            accessible-label: root.edit-label;
            is-enabled: root.is-edit-enabled;
            clicked => { root.edit(); }
        }
    }
}

// The form an Edit button opens in place: its fields, the error it raised, then Cancel and Save.
component AccountEditForm inherits VerticalLayout {
    in property <string> save-label;
    in property <string> busy-label;
    in property <bool> is-save-enabled;
    in property <bool> is-busy;
    // Empty hides it.
    in property <string> error-message;
    callback save();
    callback cancel();
    spacing: MellowComponent.text-field-field-gap;

    @children
    if root.error-message != "": StatusLine {
        text: root.error-message;
        is-error: true;
    }
    HorizontalLayout {
        alignment: end;
        spacing: MellowComponent.settings-account-button-gap;
        Button {
            label: "Cancel";
            is-enabled: !root.is-busy;
            clicked => { root.cancel(); }
        }
        // The label says what is happening while busy (DESIGN.md §6.1, loading state).
        Button {
            label: root.is-busy ? root.busy-label : root.save-label;
            is-primary: true;
            is-enabled: root.is-save-enabled && !root.is-busy;
            clicked => { root.save(); }
        }
    }
}

// Discord's account card background and padding around rows or a form.
component AccountCard inherits Rectangle {
    background: MellowComponent.settings-account-card-background;
    border-radius: MellowComponent.settings-account-card-radius;
    VerticalLayout {
        padding: MellowComponent.settings-account-card-padding;
        spacing: MellowComponent.settings-account-row-gap;
        @children
    }
}

// User settings (DESIGN.md §5.8 layout, §5.9 sections), over the whole window: My account (the
// default) and About.
export component UserSettingsScreen inherits Rectangle {
    in property <string> app-version;
    in property <UpdateStatus> update-status;
    in property <string> available-version;
    in property <string> update-error-text;
    // My account. The username comes without its `@`.
    in property <string> account-display-name;
    in property <string> account-username;
    in property <string> account-email;
    in property <bool> is-account-busy;
    // Empty hides it; shown under the form whose save raised it.
    in property <string> account-error;
    // Empty hides it; shown where the saved form was.
    in property <string> account-notice;
    // Incremented by Rust after every successful save: the open form closes and forgets its fields.
    in property <int> account-saved-count;
    // Below the navigator breakpoint the page fills the window and tightens its side padding.
    in property <bool> is-narrow;
    // Appearance: the theme lives in AppWindow; reduced motion in `MotionPreference`. Rust saves both
    // after each change.
    in-out property <ThemeChoice> theme-choice;
    callback appearance-changed();
    callback close();
    callback sign-out();
    callback check-for-updates();
    callback install-update();
    callback restart-to-update();
    callback save-display-name(string);
    // New username, current password.
    callback save-username(string, string);
    // Current password, new password.
    callback change-password(string, string);

    property <SettingsSection> section: SettingsSection.account;
    property <AccountEditor> editor: AccountEditor.none;
    // The form that last started a save, and the one that last succeeded: they place the error and
    // the notice, and an error left from an earlier form never shows under a new one.
    property <AccountEditor> error-editor: AccountEditor.none;
    property <AccountEditor> notice-editor: AccountEditor.none;
    // The row (or the "Change password" button) that takes focus back when its form closes.
    property <AccountEditor> focus-return: AccountEditor.none;
    property <string> display-name-draft;
    property <string> username-draft;
    property <string> current-password-draft;
    property <string> new-password-draft;
    property <string> confirm-password-draft;
    property <string> visible-account-error: editor != AccountEditor.none && error-editor == editor ? account-error : "";

    // Mirrors the server's rules (mellow-server domain/account_rules.rs); the server still decides.
    property <bool> can-save-display-name: display-name-draft != "" && display-name-draft != account-display-name;
    property <bool> can-save-username: username-draft != "" && username-draft != account-username && current-password-draft != "";
    // As the server's account rules. shortcut: Slint counts grapheme clusters, the server counts
    // chars, so only exotic passwords (combining marks, emoji sequences) are held back here.
    property <int> minimum-password-length: 10;
    property <bool> is-new-password-long-enough: new-password-draft.character-count >= minimum-password-length;
    property <bool> does-confirmation-match: confirm-password-draft == new-password-draft;
    property <bool> can-change-password: current-password-draft != "" && is-new-password-long-enough
        && confirm-password-draft != "" && does-confirmation-match;

    property <bool> is-update-busy: update-status == UpdateStatus.checking || update-status == UpdateStatus.downloading;
    property <bool> has-update-action: update-status != UpdateStatus.unsupported;
    property <bool> is-update-failure: update-status == UpdateStatus.failed || update-status == UpdateStatus.unsupported;
    property <string> update-sentence: update-status == UpdateStatus.up-to-date ? "Mellow is up to date."
        : update-status == UpdateStatus.checking ? "Checking for updates…"
        : update-status == UpdateStatus.available ? "Mellow " + available-version + " is available."
        : update-status == UpdateStatus.downloading ? "Downloading Mellow " + available-version + "…"
        : update-status == UpdateStatus.ready-to-restart ? "Mellow " + available-version + " is ready. Restart to finish updating."
        : is-update-failure ? update-error-text : "";
    property <string> update-action-label: update-status == UpdateStatus.available || update-status == UpdateStatus.downloading ? "Update Mellow"
        : update-status == UpdateStatus.ready-to-restart ? "Restart Mellow"
        : update-status == UpdateStatus.failed ? "Try again" : "Check for updates";

    function run-update-action() {
        if update-status == UpdateStatus.available {
            root.install-update();
        } else if update-status == UpdateStatus.ready-to-restart {
            root.restart-to-update();
        } else if !is-update-busy && has-update-action {
            root.check-for-updates();
        }
    }

    function clear-drafts() {
        display-name-draft = "";
        username-draft = "";
        current-password-draft = "";
        new-password-draft = "";
        confirm-password-draft = "";
    }

    function open-editor(form: AccountEditor) {
        clear-drafts();
        // Prefilled, as Discord does: the change is usually small.
        if form == AccountEditor.display-name {
            display-name-draft = account-display-name;
        } else if form == AccountEditor.username {
            username-draft = account-username;
        }
        focus-return = AccountEditor.none;
        error-editor = AccountEditor.none;
        notice-editor = AccountEditor.none;
        editor = form;
    }

    // Typed passwords are not kept once their form closes.
    function close-editor() {
        clear-drafts();
        focus-return = editor;
        editor = AccountEditor.none;
    }

    function select-section(next: SettingsSection) {
        if next == section {
            return;
        }
        clear-drafts();
        editor = AccountEditor.none;
        focus-return = AccountEditor.none;
        section = next;
    }

    function save-open-form() {
        if is-account-busy {
            return;
        }
        if editor == AccountEditor.display-name && can-save-display-name {
            root.save-display-name(display-name-draft);
        } else if editor == AccountEditor.username && can-save-username {
            root.save-username(username-draft, current-password-draft);
        } else if editor == AccountEditor.password && can-change-password {
            root.change-password(current-password-draft, new-password-draft);
        }
    }

    // Focus lands on the selected section, so screen readers start in the navigation, as on Discord.
    init => { account-item.focus(); }
    changed is-account-busy => {
        if is-account-busy {
            error-editor = editor;
        }
    }
    // Also without a busy phase, for an error Rust raises before sending anything.
    changed account-error => {
        if account-error != "" {
            error-editor = editor;
        }
    }
    changed account-saved-count => {
        notice-editor = editor;
        close-editor();
    }

    // The ground; the page is a card on it, as in the shell (ADR-0022).
    background: MellowColor.surface-rail;

    function choose-theme(choice: ThemeChoice) {
        root.theme-choice = choice;
        root.appearance-changed();
    }
    function choose-reduced-motion(is-reduced: bool) {
        MotionPreference.is-reduced = is-reduced;
        root.appearance-changed();
    }

    // Nothing behind the screen reacts to the pointer.
    TouchArea { }

    key-scope := FocusScope {
        focus-on-click: false;
        key-pressed(event) => {
            if event.text == Key.Escape {
                // Esc first closes the open form, as it would close Discord's dialog for it.
                if editor != AccountEditor.none {
                    if !is-account-busy {
                        close-editor();
                    }
                } else {
                    root.close();
                }
                return accept;
            }
            reject
        }

        HorizontalLayout {
            padding: root.is-narrow ? 0px : MellowSize.sheet-inset;
            spacing: root.is-narrow ? 0px : MellowSize.sheet-inset;
            // Grows with the window and keeps the navigation against the content, as on Discord. It
            // takes a third of what the page's padding leaves, as the mockup's flex basis does.
            Rectangle {
                width: max(MellowComponent.settings-nav-width, (root.width - 3 * MellowSize.sheet-inset
                    - MellowComponent.settings-content-padding-inline - MellowSpace.lg) / 3);
                accessible-role: navigation;
                accessible-label: "User settings";

                VerticalLayout {
                    x: parent.width - self.width;
                    width: MellowComponent.settings-nav-width;
                    height: parent.height;
                    alignment: start;
                    padding-top: MellowComponent.settings-nav-padding-top;
                    padding-left: MellowComponent.settings-nav-padding-leading;
                    padding-right: MellowComponent.settings-nav-padding-trailing;

                    NavGroup {
                        label: "User settings";
                        account-item := SettingsNavItem {
                            label: "My account";
                            is-selected: root.section == SettingsSection.account;
                            activated => { root.select-section(SettingsSection.account); }
                        }
                    }
                    NavSeparator { }
                    NavGroup {
                        label: "App settings";
                        SettingsNavItem {
                            label: "Appearance";
                            is-selected: root.section == SettingsSection.appearance;
                            activated => { root.select-section(SettingsSection.appearance); }
                        }
                        SettingsNavItem {
                            label: "About";
                            is-selected: root.section == SettingsSection.about;
                            activated => { root.select-section(SettingsSection.about); }
                        }
                    }
                    NavSeparator { }
                    SettingsNavItem {
                        label: "Sign out";
                        is-danger: true;
                        accessible-role: button;
                        activated => { root.sign-out(); }
                    }
                }
            }

            Rectangle {
                horizontal-stretch: 1;
                preferred-width: MellowComponent.settings-content-max-width;
                min-width: 0px;
                border-radius: root.is-narrow ? 0px : MellowComponent.sheet-radius;
                background: MellowComponent.settings-content-background;
                clip: true;

                // Open forms make My account taller than short windows.
                page-scroll := ScrollView {
                    content-width: self.visible-width;
                    content-height: page-row.preferred-height;

                    page-row := HorizontalLayout {
                        width: page-scroll.visible-width;
                        alignment: start;
                        padding-top: MellowComponent.settings-content-padding-top;
                        padding-bottom: MellowComponent.settings-content-padding-bottom;
                        padding-left: root.is-narrow ? MellowComponent.settings-content-padding-inline-narrow : MellowComponent.settings-content-padding-inline;
                        padding-right: root.is-narrow ? MellowComponent.settings-content-padding-inline-narrow : MellowSpace.lg;
                        spacing: root.is-narrow ? MellowComponent.settings-close-gap-narrow : MellowComponent.settings-close-gap;

                        // Takes the full cap when it fits, and shrinks first on narrow windows.
                        VerticalLayout {
                            horizontal-stretch: 1;
                            min-width: 0px;
                            preferred-width: MellowComponent.settings-content-max-width;
                            max-width: MellowComponent.settings-content-max-width;
                            alignment: start;

                            if root.section == SettingsSection.account: Rectangle {
                                accessible-role: tab-panel;
                                accessible-label: "My account";
                                VerticalLayout {
                                    alignment: start;
                                    Text {
                                        text: "My account";
                                        color: MellowComponent.settings-page-title-text;
                                        font-size: MellowType.heading-lg.font-size;
                                        font-weight: MellowType.heading-lg.font-weight;
                                        overflow: elide;
                                    }
                                    Rectangle { height: MellowComponent.settings-page-title-gap; }

                                    AccountCard {
                                        if root.editor != AccountEditor.display-name: VerticalLayout {
                                            spacing: MellowComponent.settings-section-label-gap;
                                            AccountFieldRow {
                                                label: "Display name";
                                                value: root.account-display-name;
                                                edit-label: "Edit display name";
                                                is-edit-enabled: !root.is-account-busy;
                                                should-take-focus: root.focus-return == AccountEditor.display-name;
                                                edit => { root.open-editor(AccountEditor.display-name); }
                                            }
                                            if root.notice-editor == AccountEditor.display-name && root.account-notice != "": StatusLine {
                                                text: root.account-notice;
                                            }
                                        }
                                        if root.editor == AccountEditor.display-name: AccountEditForm {
                                            save-label: "Save";
                                            busy-label: "Saving…";
                                            is-save-enabled: root.can-save-display-name;
                                            is-busy: root.is-account-busy;
                                            error-message: root.visible-account-error;
                                            save => { root.save-open-form(); }
                                            cancel => { root.close-editor(); }
                                            TextField {
                                                label: "Display name";
                                                helper: "Up to 32 characters. This is the name people see in chat.";
                                                text <=> root.display-name-draft;
                                                wants-focus: true;
                                                is-read-only: root.is-account-busy;
                                                accepted => { root.save-open-form(); }
                                            }
                                        }

                                        if root.editor != AccountEditor.username: VerticalLayout {
                                            spacing: MellowComponent.settings-section-label-gap;
                                            AccountFieldRow {
                                                label: "Username";
                                                value: "@" + root.account-username;
                                                edit-label: "Edit username";
                                                is-edit-enabled: !root.is-account-busy;
                                                should-take-focus: root.focus-return == AccountEditor.username;
                                                edit => { root.open-editor(AccountEditor.username); }
                                            }
                                            if root.notice-editor == AccountEditor.username && root.account-notice != "": StatusLine {
                                                text: root.account-notice;
                                            }
                                        }
                                        if root.editor == AccountEditor.username: AccountEditForm {
                                            save-label: "Save";
                                            busy-label: "Saving…";
                                            is-save-enabled: root.can-save-username;
                                            is-busy: root.is-account-busy;
                                            error-message: root.visible-account-error;
                                            save => { root.save-open-form(); }
                                            cancel => { root.close-editor(); }
                                            TextField {
                                                label: "Username";
                                                // Mirrors the server's rule (mellow-server domain/account_rules.rs).
                                                helper: "2 to 32 characters: lowercase letters, digits, dots and underscores.";
                                                text <=> root.username-draft;
                                                wants-focus: true;
                                                is-read-only: root.is-account-busy;
                                                accepted => { root.save-open-form(); }
                                            }
                                            TextField {
                                                label: "Current password";
                                                is-password: true;
                                                text <=> root.current-password-draft;
                                                is-read-only: root.is-account-busy;
                                                accepted => { root.save-open-form(); }
                                            }
                                        }

                                        AccountFieldValue {
                                            label: "Email";
                                            value: root.account-email;
                                        }
                                    }

                                    Rectangle { height: MellowComponent.settings-section-gap; }
                                    SectionLabel {
                                        label: "Password";
                                    }
                                    Rectangle { height: MellowComponent.settings-section-label-gap; }

                                    if root.editor != AccountEditor.password: VerticalLayout {
                                        spacing: MellowComponent.settings-action-gap;
                                        HorizontalLayout {
                                            alignment: start;
                                            Button {
                                                label: "Change password";
                                                is-primary: true;
                                                is-enabled: !root.is-account-busy;
                                                init => {
                                                    if root.focus-return == AccountEditor.password {
                                                        self.focus();
                                                    }
                                                }
                                                clicked => { root.open-editor(AccountEditor.password); }
                                            }
                                        }
                                        if root.notice-editor == AccountEditor.password && root.account-notice != "": StatusLine {
                                            text: root.account-notice;
                                        }
                                    }
                                    if root.editor == AccountEditor.password: AccountCard {
                                        AccountEditForm {
                                            save-label: "Change password";
                                            busy-label: "Changing password…";
                                            is-save-enabled: root.can-change-password;
                                            is-busy: root.is-account-busy;
                                            error-message: root.visible-account-error;
                                            save => { root.save-open-form(); }
                                            cancel => { root.close-editor(); }
                                            TextField {
                                                label: "Current password";
                                                is-password: true;
                                                text <=> root.current-password-draft;
                                                wants-focus: true;
                                                is-read-only: root.is-account-busy;
                                                accepted => { root.save-open-form(); }
                                            }
                                            TextField {
                                                label: "New password";
                                                is-password: true;
                                                // Same server rule as registration.
                                                helper: "At least " + minimum-password-length + " characters.";
                                                text <=> root.new-password-draft;
                                                is-read-only: root.is-account-busy;
                                                accepted => { root.save-open-form(); }
                                            }
                                            TextField {
                                                label: "Confirm new password";
                                                is-password: true;
                                                // Says why Save stays disabled while the two differ.
                                                helper: root.confirm-password-draft != "" && !root.does-confirmation-match
                                                    ? "Doesn't match the new password." : "";
                                                text <=> root.confirm-password-draft;
                                                is-read-only: root.is-account-busy;
                                                accepted => { root.save-open-form(); }
                                            }
                                        }
                                    }
                                }
                            }

                            if root.section == SettingsSection.appearance: Rectangle {
                                accessible-role: tab-panel;
                                accessible-label: "Appearance";
                                VerticalLayout {
                                    alignment: start;
                                    Text {
                                        text: "Appearance";
                                        color: MellowComponent.settings-page-title-text;
                                        font-size: MellowType.heading-lg.font-size;
                                        font-weight: MellowType.heading-lg.font-weight;
                                        letter-spacing: MellowType.heading-lg.letter-spacing;
                                        overflow: elide;
                                    }
                                    Rectangle { height: MellowComponent.settings-page-title-gap; }
                                    SettingsSectionBlock {
                                        label: "Theme";
                                        Segmented {
                                            label: "Theme";
                                            SegmentedChoice {
                                                label: "Match system";
                                                is-chosen: root.theme-choice == ThemeChoice.system;
                                                chosen => { root.choose-theme(ThemeChoice.system); }
                                            }
                                            SegmentedChoice {
                                                label: "Dark";
                                                is-chosen: root.theme-choice == ThemeChoice.dark;
                                                chosen => { root.choose-theme(ThemeChoice.dark); }
                                            }
                                            SegmentedChoice {
                                                label: "Light";
                                                is-chosen: root.theme-choice == ThemeChoice.light;
                                                chosen => { root.choose-theme(ThemeChoice.light); }
                                            }
                                        }
                                    }
                                    Rectangle { height: MellowSpace.xl; }
                                    // Slint does not expose the system's reduced-motion setting, so this
                                    // is a stored choice rather than "Match system" (DESIGN.md §2.8).
                                    SettingsSectionBlock {
                                        label: "Motion";
                                        description: "Reducing motion replaces movement with instant changes. Colour changes stay, so you still see what happened.";
                                        Segmented {
                                            label: "Motion";
                                            SegmentedChoice {
                                                label: "Allow motion";
                                                is-chosen: !MotionPreference.is-reduced;
                                                chosen => { root.choose-reduced-motion(false); }
                                            }
                                            SegmentedChoice {
                                                label: "Reduce motion";
                                                is-chosen: MotionPreference.is-reduced;
                                                chosen => { root.choose-reduced-motion(true); }
                                            }
                                        }
                                    }
                                }
                            }

                            if root.section == SettingsSection.about: Rectangle {
                                accessible-role: tab-panel;
                                accessible-label: "About";
                                // The action button disappears when updating is unsupported: keep focus inside the screen.
                                property <bool> has-update-action: root.has-update-action;
                                changed has-update-action => {
                                    if !self.has-update-action && update-button.has-keyboard-focus {
                                        key-scope.focus();
                                    }
                                }
                                VerticalLayout {
                                    alignment: start;
                                    Text {
                                        text: "About";
                                        color: MellowComponent.settings-page-title-text;
                                        font-size: MellowType.heading-lg.font-size;
                                        font-weight: MellowType.heading-lg.font-weight;
                                        overflow: elide;
                                    }
                                    Rectangle { height: MellowComponent.settings-page-title-gap; }
                                    Text {
                                        text: root.app-version == "" ? "Mellow" : "Mellow " + root.app-version;
                                        color: MellowComponent.settings-app-name-text;
                                        font-size: MellowType.heading-md.font-size;
                                        font-weight: MellowType.heading-md.font-weight;
                                        wrap: word-wrap;
                                    }
                                    Rectangle { height: MellowComponent.settings-section-gap; }

                                    SectionLabel {
                                        label: "Updates";
                                    }
                                    Rectangle { height: MellowComponent.settings-section-label-gap; }
                                    if root.update-sentence != "": HorizontalLayout {
                                        spacing: MellowComponent.settings-error-icon-gap;
                                        if root.update-status == UpdateStatus.failed: VerticalLayout {
                                            alignment: start;
                                            Image {
                                                source: @image-url("../../icons/warning-circle.svg");
                                                colorize: MellowComponent.settings-error-icon;
                                                width: MellowComponent.settings-error-icon-size;
                                                height: self.width;
                                                accessible-role: none;
                                            }
                                        }
                                        Text {
                                            text: root.update-sentence;
                                            color: MellowComponent.settings-body-text;
                                            font-size: MellowType.body-lg.font-size;
                                            wrap: word-wrap;
                                            horizontal-stretch: 1;
                                            // Announced through the live region below instead.
                                            accessible-role: none;
                                        }
                                    }
                                    Rectangle {
                                        height: root.has-update-action && root.update-sentence != "" ? MellowComponent.settings-action-gap : 0px;
                                    }
                                    HorizontalLayout {
                                        alignment: start;
                                        update-button := Button {
                                            // Hidden rather than removed, so the focus check above can still read it.
                                            visible: root.has-update-action;
                                            height: root.has-update-action ? MellowComponent.button-height : 0px;
                                            label: root.update-action-label;
                                            is-primary: true;
                                            is-enabled: !root.is-update-busy;
                                            clicked => { root.run-update-action(); }
                                        }
                                    }
                                }
                            }
                        }

                        CloseButton {
                            clicked => { root.close(); }
                        }
                    }
                }
            }
        }
    }

    // Changes are announced here; the regions exist from the start, so their first change counts.
    Text {
        width: 0px;
        height: 0px;
        text: root.update-sentence;
        accessible-role: text;
        accessible-live-region: polite;
    }
    Text {
        width: 0px;
        height: 0px;
        text: root.account-notice;
        accessible-role: text;
        accessible-live-region: polite;
    }
    Text {
        width: 0px;
        height: 0px;
        text: root.visible-account-error;
        accessible-role: text;
        accessible-live-region: assertive;
    }
}
