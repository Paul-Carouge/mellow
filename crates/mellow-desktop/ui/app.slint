import { Palette } from "std-widgets.slint";
import { MellowColor, MellowComponent, MellowSize, MellowSpace, MellowTheme, MellowType } from "tokens.slint";
import { MotionPreference, ThemeChoice } from "preferences.slint";
// Bundled into the binary so every platform renders the same typeface (DESIGN.md §2.4).
import "../fonts/Figtree[wght].ttf";
import "../fonts/Figtree-Italic[wght].ttf";
import { ServerItem } from "components/server_rail.slint";
import { Navigator } from "components/navigator.slint";
import { QuickSwitcher, QuickSwitcherKind, QuickSwitcherRow } from "components/quick_switcher.slint";
import { MelliAnimation, MelliState } from "components/melli.slint";
import { ChannelListRow, DirectMessageRow } from "components/channel_sidebar.slint";
import { AttachmentRow, TypingLine, ChatPane, HistoryStartState, MessageDelivery, MessageRow } from "components/chat_pane.slint";
import { MemberListRow, MemberSheet } from "components/member_list.slint";
import { PresenceStatus, RoleColor } from "components/primitives.slint";
import { LoginScreen } from "components/login_screen.slint";
import { ConnectionBanner } from "components/connection_banner.slint";
import { DeleteMessageDialog } from "components/delete_message_dialog.slint";
import { UpdateStatus, UserSettingsScreen } from "components/user_settings.slint";
import { RoleListRow, RolePermissionRow, ServerSettingsScreen } from "components/server_settings.slint";
import { AddServerDialog, CreateChannelDialog, InvitePeopleDialog, LeaveServerDialog } from "components/server_dialogs.slint";

export { AttachmentRow, TypingLine, MellowComponent, QuickSwitcherKind, QuickSwitcherRow, RoleColor, MelliAnimation, MelliState, ServerItem, ChannelListRow, DirectMessageRow, HistoryStartState, MessageDelivery, MessageRow, MemberListRow, PresenceStatus, MellowTheme, MotionPreference, ThemeChoice, UpdateStatus, RoleListRow, RolePermissionRow }

// The window-wide dialog open over the shell, if any (DESIGN.md §6.35).
export enum ShellDialog { none, add-server, invite-people, create-channel, leave-server }

// Window width breakpoints from DESIGN.md §4.2: each one is the sum of the cards it must fit, with
// the ground showing `size.sheet.inset` around each card.
global LayoutBreakpoint {
    // 8 + 312 + 8 + 480 + 8 = 816.
    out property <length> navigator-visible: 3 * MellowSize.sheet-inset + MellowComponent.navigator-strip-width
        + MellowComponent.sidebar-width + MellowSize.chat-min-width;
    // 816 + 240 + 8 = 1064.
    out property <length> side-sheet-docked: navigator-visible + MellowComponent.side-sheet-width + MellowSize.sheet-inset;
}

export component AppWindow inherits Window {
    in property <[ServerItem]> servers;
    in-out property <int> selected-server-index;
    in property <string> server-name;
    in property <[ChannelListRow]> channel-rows;
    in property <string> selected-channel-id;
    in property <string> selected-channel-name;
    in property <string> selected-channel-topic;
    in property <[MessageRow]> messages;
    in property <[MemberListRow]> member-rows;
    in property <string> current-user-name;
    in property <string> current-user-initial;
    // The signed-in user's default avatar tint, 0 to 7.
    in property <int> current-user-tint;
    in property <string> latest-announcement;
    in-out property <string> composer-text;
    in-out property <bool> is-text-selection-mode;
    // The member side sheet: closed by default, remembered per server by Rust (DESIGN.md §5.7).
    in-out property <bool> is-member-list-visible: false;
    // After the person opens or closes the member sheet (button or Ctrl+U), so Rust remembers it.
    callback member-sheet-toggled();
    // Appearance (DESIGN.md §5.9): Rust loads and saves both, and is told after each change.
    in-out property <ThemeChoice> theme-choice: ThemeChoice.system;
    callback appearance-changed();
    // Development builds preview controls whose feature has not shipped (microphone and headset);
    // release builds hide them (ADR-0022 §5).
    in property <bool> shows-unreleased-controls;
    in property <bool> is-signed-in;
    // Empty hides the banner.
    in property <string> connection-notice;
    in-out property <string> login-instance-address;
    in-out property <string> login-login;
    in-out property <string> login-username;
    in-out property <string> login-email;
    in-out property <string> login-password;
    in-out property <bool> login-is-registering;
    in property <bool> login-is-busy;
    in property <string> login-error-message;
    // Message actions (DESIGN.md §5.4, §5.5); see ChatPane for each one's meaning.
    in property <string> replying-to-author;
    in-out property <int> editing-message-index: -1;
    in-out property <string> editing-message-draft;
    in-out property <int> deleting-message-index: -1;
    in property <string> message-action-error;
    in property <bool> can-send-messages: true;
    // User settings (DESIGN.md §5.9) and the app's self-update, shown under About.
    in-out property <bool> is-user-settings-open: false;
    in property <string> app-version;
    in property <UpdateStatus> update-status;
    // Set while the status is available, downloading or ready-to-restart.
    in property <string> available-version;
    // Shown when the status is failed or unsupported; user-facing text built in Rust.
    in property <string> update-error-text;
    // User settings, My account (DESIGN.md §5.9). The username comes without its `@`.
    in property <string> account-display-name;
    in property <string> account-username;
    in property <string> account-email;
    in property <bool> is-account-busy;
    // Empty hides it; shown under the form being edited. User-facing text built in Rust.
    in property <string> account-error;
    // Empty hides it; success text, announced politely.
    in property <string> account-notice;
    // Incremented after every successful save: the open form closes and forgets its fields.
    in property <int> account-saved-count;
    // Server settings (DESIGN.md §5.8), Roles section. Rust owns the selection and the role draft.
    in property <bool> can-open-server-settings;
    in-out property <bool> is-server-settings-open: false;
    in property <[RoleListRow]> server-settings-roles;
    in property <int> selected-role-index: -1;
    in-out property <string> role-draft-name;
    in property <color> role-draft-color;
    in property <bool> role-draft-has-color;
    in property <[color]> role-color-presets;
    in property <[RolePermissionRow]> role-permission-rows;
    // False for roles the signed-in user cannot edit (locked).
    in property <bool> is-role-draft-editable;
    in property <bool> has-unsaved-role-changes;
    in property <bool> is-role-action-busy;
    // Empty hides it; user-facing text built in Rust.
    in property <string> role-action-error;
    in property <bool> can-create-roles;
    // Server dialogs: add (create or join) a server, invite people, create a channel, leave a server.
    // Slint opens them; Rust sets none on success, then calls restore-focus-after-dialog.
    in-out property <ShellDialog> open-dialog: ShellDialog.none;
    in property <bool> is-dialog-busy;
    // Empty hides it; user-facing text built in Rust.
    in property <string> dialog-error;
    // Empty while it is being created.
    in property <string> invite-code;
    in property <bool> can-invite-people;
    in property <bool> can-create-channels;
    // Where "Create channel" puts the channel: a category's id from its "+", or empty for none.
    in-out property <string> create-channel-category-id;
    in-out property <string> create-channel-category-name;
    in property <bool> can-leave-server;
    // Direct messages (DESIGN.md §5.6). Home is selected: the sidebar lists conversations.
    in property <bool> is-home;
    in property <[DirectMessageRow]> direct-message-rows;
    in property <bool> has-unread-direct-messages;
    // What Melli shows in the Home button (DESIGN.md §2.10); Rust maps connection and unread.
    in property <MelliState> home-melli-state;
    // The open channel is a conversation: `@` naming, no member list.
    in property <bool> is-direct-message-open;
    // User id, from the member list's profile popout. Selecting a conversation calls select-channel.
    callback open-direct-message(string);

    property <bool> has-update-available: update-status == UpdateStatus.available || update-status == UpdateStatus.ready-to-restart;
    property <int> settings-button-focus-request-count;
    property <int> server-header-focus-request-count;

    // Set from `changed width` rather than bound to `width`: a binding would make the layout depend
    // on itself (the cards' presence changes the window's minimum width).
    property <bool> is-wide-enough-to-dock-side-sheet: true;
    property <bool> is-wide-enough-for-sidebar: true;
    changed width => {
        self.is-wide-enough-to-dock-side-sheet = self.width >= LayoutBreakpoint.side-sheet-docked;
        self.is-wide-enough-for-sidebar = self.width >= LayoutBreakpoint.navigator-visible;
        if self.is-wide-enough-for-sidebar {
            self.is-navigator-drawer-open = false;
        }
    }
    // Below the navigator breakpoint the navigator opens as a drawer over the sheet.
    in-out property <bool> is-navigator-drawer-open;
    property <bool> is-member-sheet-shown: is-member-list-visible && !is-direct-message-open;
    property <bool> is-member-sheet-docked: is-member-sheet-shown && is-wide-enough-to-dock-side-sheet;

    // Theme: the OS's scheme through Slint's palette, unless the person chose one.
    property <bool> is-dark-theme: theme-choice == ThemeChoice.dark
        || (theme-choice == ThemeChoice.system && Palette.color-scheme != ColorScheme.light);
    changed is-dark-theme => {
        MellowTheme.is-dark = self.is-dark-theme;
        self.theme-changed();
    }
    // After the theme changes: Rust rebuilds what it coloured itself (mentions in messages).
    callback theme-changed();

    function toggle-member-sheet() {
        if root.is-direct-message-open {
            return;
        }
        root.is-member-list-visible = !root.is-member-list-visible;
        root.member-sheet-toggled();
        // Over the sheet it took the focus; give it back to where people type.
        if !root.is-member-list-visible {
            chat.focus-composer();
        }
    }

    callback select-server(int);
    callback select-channel(string);
    callback toggle-category(int);
    callback send-message(string);
    callback link-clicked(string);
    callback copy-message-text(int);
    callback reply-to-message(int);
    callback cancel-reply();
    callback save-message-edit(int, string);
    callback edit-last-own-message();
    callback delete-message(int);
    callback retry-message(int);
    callback discard-failed-message(int);
    callback load-older-messages();
    in property <HistoryStartState> history-start-state;
    callback retry-loading-history();
    // "N new messages since HH:MM" (DESIGN.md §5.4); empty hides the bar. Rust clears it on Mark as read.
    in property <string> unread-bar-text;
    callback mark-channel-read();
    // The quick switcher (DESIGN.md §5.10): Rust fills the rows for each query and opens the
    // chosen result (its option index).
    in-out property <bool> is-quick-switcher-open;
    in property <[QuickSwitcherRow]> quick-switcher-rows;
    callback quick-switcher-query-changed(string);
    callback quick-switcher-chosen(int);
    // Who types in the open channel, in pieces so the names are bold; empty when nobody does.
    in property <TypingLine> typing-line;
    callback sign-in();
    callback register();
    callback sign-out();
    callback check-for-updates();
    callback install-update();
    callback restart-to-update();
    callback save-display-name(string);
    // New username, current password.
    callback save-username(string, string);
    // Current password, new password.
    callback change-password(string, string);
    // Rust sets is-server-settings-open and fills the role models.
    callback open-server-settings();
    // Called only without unsaved role changes; Slint closes the screen itself.
    callback close-server-settings();
    callback select-role(int);
    callback role-draft-name-edited();
    // Preset index, -1 for no colour.
    callback choose-role-color(int);
    callback toggle-role-permission(int);
    callback save-role-changes();
    callback reset-role-changes();
    callback create-role();
    callback delete-role(int);
    callback move-role-up(int);
    callback move-role-down(int);
    callback create-server(string);
    callback join-server(string);
    callback create-invite();
    callback copy-invite-code();
    callback create-channel(string);
    callback leave-server();
    // Whenever the person closes a dialog (Esc, Cancel, Close, scrim), after open-dialog is none.
    callback dialog-closed();

    // Focus goes back to the settings button, or to the composer while the sidebar is hidden.
    function close-user-settings() {
        root.is-user-settings-open = false;
        if root.is-wide-enough-for-sidebar {
            root.settings-button-focus-request-count += 1;
        } else {
            chat.focus-composer();
        }
    }

    // Focus goes back to the server header, or to the composer while the sidebar is hidden.
    function leave-server-settings() {
        root.is-server-settings-open = false;
        root.close-server-settings();
        root.restore-focus-after-server-settings();
    }

    // Also called from Rust when it closes settings itself (the guild is gone).
    public function restore-focus-after-server-settings() {
        if root.is-wide-enough-for-sidebar {
            root.server-header-focus-request-count += 1;
        } else {
            chat.focus-composer();
        }
    }

    function open-create-channel-dialog(category-id: string, category-name: string) {
        root.create-channel-category-id = category-id;
        root.create-channel-category-name = category-name;
        root.open-dialog = ShellDialog.create-channel;
    }

    function open-quick-switcher() {
        root.is-navigator-drawer-open = false;
        root.is-quick-switcher-open = true;
        root.quick-switcher-query-changed("");
    }

    function close-dialog() {
        root.open-dialog = ShellDialog.none;
        root.dialog-closed();
        root.restore-focus-after-dialog();
    }

    // Focus goes back to the composer, as after the delete dialog: the menu item or rail button
    // that opened the dialog is gone or would reopen it. Also called from Rust after a success.
    // A read-only channel has no composer to focus, so the server header takes it then.
    public function restore-focus-after-dialog() {
        if root.can-send-messages || !root.is-wide-enough-for-sidebar {
            chat.focus-composer();
        } else {
            root.server-header-focus-request-count += 1;
        }
    }

    public function focus-composer() {
        chat.focus-composer();
    }
    public function scroll-to-latest-message() {
        chat.scroll-to-latest-message();
    }
    public function keep-distance-from-latest-message() {
        chat.keep-distance-from-latest-message();
    }
    public function note-new-message() {
        chat.note-new-message();
    }
    public function scroll-up-by(distance: length) -> bool {
        chat.scroll-up-by(distance)
    }

    title: "Mellow";
    // Melli, generated by `cargo xtask tokens` and embedded in the binary (DESIGN.md §2.10).
    icon: @image-url("../../../release/icons/mellow-256.png");
    preferred-width: MellowSize.window-default-width;
    preferred-height: MellowSize.window-default-height;
    min-width: MellowSize.window-min-width;
    min-height: MellowSize.window-min-height;
    // The ground the cards sit on (ADR-0022).
    background: MellowColor.surface-rail;
    default-font-family: MellowType.message.font-family;

    forward-focus: key-handler;
    // Typing goes to the composer on launch, as on Discord.
    init => {
        MellowTheme.is-dark = root.is-dark-theme;
        if root.is-signed-in {
            chat.focus-composer();
        }
    }
    // The shell exists from the start (hidden), so its init focus has to be redone once it shows.
    changed is-signed-in => {
        if root.is-signed-in {
            chat.focus-composer();
        } else {
            // A session ended by the server must not reopen settings over the next sign-in.
            root.is-user-settings-open = false;
            root.is-server-settings-open = false;
            root.open-dialog = ShellDialog.none;
        }
    }

    // Key events bubble up from the focused child to this scope, so shortcuts work anywhere.
    key-handler := FocusScope {
        // Hidden rather than removed while signed out or in settings, so `chat` stays addressable
        // and keeps its scroll position; hidden items are skipped by Tab and left out of the
        // accessibility tree.
        visible: root.is-signed-in && !root.is-user-settings-open && !root.is-server-settings-open;
        key-pressed(event) => {
            if event.text == Key.F2 {
                root.is-text-selection-mode = !root.is-text-selection-mode;
                return accept;
            }
            // Ctrl+K opens the quick switcher (DESIGN.md §5.10).
            if event.modifiers.control && (event.text == "k" || event.text == "K") {
                root.open-quick-switcher();
                return accept;
            }
            // Ctrl+U shows or hides the members, as on Discord (DESIGN.md §7.2).
            if event.modifiers.control && (event.text == "u" || event.text == "U") {
                root.toggle-member-sheet();
                return accept;
            }
            if event.text == Key.Escape && root.is-navigator-drawer-open {
                root.is-navigator-drawer-open = false;
                chat.focus-composer();
                return accept;
            }
            reject
        }

        VerticalLayout {
            ConnectionBanner {
                text: root.connection-notice;
            }
            // Cards on the ground (ADR-0022 §1). The top inset is doubled, and so is the trailing one
            // while the side sheet is not docked, as in the reference mockup, where the empty top bar
            // and side sheet tracks each add their gap.
            HorizontalLayout {
                padding: root.is-wide-enough-for-sidebar ? MellowSize.sheet-inset : 0px;
                padding-top: root.is-wide-enough-for-sidebar ? 2 * MellowSize.sheet-inset : 0px;
                padding-right: !root.is-wide-enough-for-sidebar ? 0px
                    : root.is-member-sheet-docked ? MellowSize.sheet-inset : 2 * MellowSize.sheet-inset;
                spacing: root.is-wide-enough-for-sidebar ? MellowSize.sheet-inset : 0px;
                if root.is-wide-enough-for-sidebar: Navigator {
                    servers: root.servers;
                    selected-server-index: root.selected-server-index;
                    has-unread-direct-messages: root.has-unread-direct-messages;
                    home-melli-state: root.home-melli-state;
                    select-server(index) => { root.select-server(index); }
                    add-server => { root.open-dialog = ShellDialog.add-server; }
                    server-name: root.server-name;
                    channel-rows: root.channel-rows;
                    is-home: root.is-home;
                    direct-message-rows: root.direct-message-rows;
                    selected-channel-id: root.selected-channel-id;
                    toggle-category(index) => { root.toggle-category(index); }
                    select-channel(id) => { root.select-channel(id); }
                    can-open-server-settings: root.can-open-server-settings;
                    server-header-focus-request-count: root.server-header-focus-request-count;
                    open-server-settings => { root.open-server-settings(); }
                    can-invite-people: root.can-invite-people;
                    can-create-channels: root.can-create-channels;
                    can-leave-server: root.can-leave-server;
                    invite-people => {
                        root.open-dialog = ShellDialog.invite-people;
                        root.create-invite();
                    }
                    create-channel => { root.open-create-channel-dialog("", ""); }
                    create-channel-in-category(id, name) => { root.open-create-channel-dialog(id, name); }
                    leave-server => { root.open-dialog = ShellDialog.leave-server; }
                    current-user-name: root.current-user-name;
                    current-user-initial: root.current-user-initial;
                    current-user-tint: root.current-user-tint;
                    current-username: root.account-username;
                    has-update-available: root.has-update-available;
                    shows-voice-controls: root.shows-unreleased-controls;
                    settings-button-focus-request-count: root.settings-button-focus-request-count;
                    open-user-settings => { root.is-user-settings-open = true; }
                }
                chat := ChatPane {
                    horizontal-stretch: 1;
                    channel-id: root.selected-channel-id;
                    channel-name: root.selected-channel-name;
                    channel-topic: root.selected-channel-topic;
                    is-direct-message: root.is-direct-message-open;
                    is-narrow: !root.is-wide-enough-for-sidebar;
                    open-quick-switcher => { root.open-quick-switcher(); }
                    is-member-sheet-open: root.is-member-sheet-shown;
                    toggle-member-sheet => { root.toggle-member-sheet(); }
                    open-navigator-drawer => { root.is-navigator-drawer-open = true; }
                    messages: root.messages;
                    is-text-selection-mode: root.is-text-selection-mode;
                    latest-announcement: root.latest-announcement;
                    composer-text <=> root.composer-text;
                    send-message(text) => { root.send-message(text); }
                    link-clicked(url) => { root.link-clicked(url); }
                    copy-message-text(index) => { root.copy-message-text(index); }
                    replying-to-author: root.replying-to-author;
                    editing-message-index <=> root.editing-message-index;
                    editing-message-draft <=> root.editing-message-draft;
                    deleting-message-index <=> root.deleting-message-index;
                    message-action-error: root.message-action-error;
                    can-send-messages: root.can-send-messages;
                    reply-to-message(index) => { root.reply-to-message(index); }
                    cancel-reply => { root.cancel-reply(); }
                    save-message-edit(index, text) => { root.save-message-edit(index, text); }
                    edit-last-own-message => { root.edit-last-own-message(); }
                    delete-message(index) => { root.delete-message(index); }
                    retry-message(index) => { root.retry-message(index); }
                    discard-failed-message(index) => { root.discard-failed-message(index); }
                    load-older-messages => { root.load-older-messages(); }
                    history-start-state: root.history-start-state;
                    retry-loading-history => { root.retry-loading-history(); }
                    unread-bar-text: root.unread-bar-text;
                    typing-line: root.typing-line;
                    mark-as-read => { root.mark-channel-read(); }
                }
                // Docked beside the sheet from 1064 px; below, it lies over the sheet (further down).
                if root.is-member-sheet-docked: MemberSheet {
                    rows: root.member-rows;
                    server-name: root.server-name;
                    is-overlay: false;
                    close => { root.toggle-member-sheet(); }
                    // Typing goes to the conversation, as on Discord; Rust focuses the composer once
                    // the conversation is open: until then it still sends to the channel being read.
                    open-direct-message(user-id) => { root.open-direct-message(user-id); }
                }
            }
        }

        // Narrower windows: the side sheet slides over the sheet's trailing side, with a scrim; below
        // the navigator breakpoint it covers the whole sheet.
        if root.is-member-sheet-shown && !root.is-wide-enough-to-dock-side-sheet: Rectangle {
            background: MellowColor.scrim;
            TouchArea {
                clicked => { root.toggle-member-sheet(); }
            }
        }
        // Inset from the sheet's own edges (top, trailing, bottom), as in the reference mockup.
        if root.is-member-sheet-shown && !root.is-wide-enough-to-dock-side-sheet: MemberSheet {
            x: root.is-wide-enough-for-sidebar ? parent.width - self.width - 2 * MellowSize.sheet-inset : 0px;
            y: root.is-wide-enough-for-sidebar ? 3 * MellowSize.sheet-inset : 0px;
            width: root.is-wide-enough-for-sidebar ? MellowComponent.side-sheet-width : parent.width;
            height: parent.height - (root.is-wide-enough-for-sidebar ? 5 * MellowSize.sheet-inset : 0px);
            card-radius: root.is-wide-enough-for-sidebar ? MellowComponent.side-sheet-radius : 0px;
            rows: root.member-rows;
            server-name: root.server-name;
            is-overlay: true;
            close => { root.toggle-member-sheet(); }
            open-direct-message(user-id) => { root.open-direct-message(user-id); }
        }

        // The navigator as a drawer from the leading edge (DESIGN.md §4.2), the same card over a scrim.
        if root.is-navigator-drawer-open && !root.is-wide-enough-for-sidebar: Rectangle {
            background: MellowColor.scrim;
            TouchArea {
                clicked => {
                    root.is-navigator-drawer-open = false;
                    chat.focus-composer();
                }
            }
        }
        if root.is-navigator-drawer-open && !root.is-wide-enough-for-sidebar: Navigator {
            x: self.entry-offset;
            y: 0;
            height: parent.height;
            border-top-left-radius: 0px;
            border-bottom-left-radius: 0px;
            // Slides from the leading edge: `motion.duration.slow`, enter curve.
            property <length> entry-offset: -MellowSpace.md;
            property <float> entry-opacity: 0;
            init => {
                self.entry-offset = 0px;
                self.entry-opacity = 1;
            }
            animate entry-offset { duration: MotionPreference.slow; easing: cubic-bezier(0, 0, 0, 1); }
            animate entry-opacity { duration: MotionPreference.slow; easing: cubic-bezier(0, 0, 0, 1); }
            opacity: self.entry-opacity;
            servers: root.servers;
            selected-server-index: root.selected-server-index;
            has-unread-direct-messages: root.has-unread-direct-messages;
            home-melli-state: root.home-melli-state;
            select-server(index) => { root.select-server(index); }
            add-server => {
                root.is-navigator-drawer-open = false;
                root.open-dialog = ShellDialog.add-server;
            }
            server-name: root.server-name;
            channel-rows: root.channel-rows;
            is-home: root.is-home;
            direct-message-rows: root.direct-message-rows;
            selected-channel-id: root.selected-channel-id;
            toggle-category(index) => { root.toggle-category(index); }
            // Opening a channel closes the drawer and shows its conversation.
            select-channel(id) => {
                root.is-navigator-drawer-open = false;
                root.select-channel(id);
                chat.focus-composer();
            }
            can-open-server-settings: root.can-open-server-settings;
            server-header-focus-request-count: root.server-header-focus-request-count;
            open-server-settings => {
                root.is-navigator-drawer-open = false;
                root.open-server-settings();
            }
            can-invite-people: root.can-invite-people;
            can-create-channels: root.can-create-channels;
            can-leave-server: root.can-leave-server;
            invite-people => {
                root.is-navigator-drawer-open = false;
                root.open-dialog = ShellDialog.invite-people;
                root.create-invite();
            }
            create-channel => {
                root.is-navigator-drawer-open = false;
                root.open-create-channel-dialog("", "");
            }
            create-channel-in-category(id, name) => {
                root.is-navigator-drawer-open = false;
                root.open-create-channel-dialog(id, name);
            }
            leave-server => {
                root.is-navigator-drawer-open = false;
                root.open-dialog = ShellDialog.leave-server;
            }
            current-user-name: root.current-user-name;
            current-user-initial: root.current-user-initial;
            current-user-tint: root.current-user-tint;
            current-username: root.account-username;
            has-update-available: root.has-update-available;
            shows-voice-controls: root.shows-unreleased-controls;
            settings-button-focus-request-count: root.settings-button-focus-request-count;
            open-user-settings => {
                root.is-navigator-drawer-open = false;
                root.is-user-settings-open = true;
            }
        }
    }

    if !root.is-signed-in: LoginScreen {
        width: root.width;
        height: root.height;
        instance-address <=> root.login-instance-address;
        login <=> root.login-login;
        username <=> root.login-username;
        email <=> root.login-email;
        password <=> root.login-password;
        is-registering <=> root.login-is-registering;
        is-busy: root.login-is-busy;
        error-message: root.login-error-message;
        sign-in => { root.sign-in(); }
        register => { root.register(); }
    }

    // Window-wide so its scrim covers every pane, as Discord's dialogs do. Focus returns to the
    // composer on close: the hover bar's Delete button that opened it is gone by then.
    // Closes by itself if the permission to delete that message is lost while it is open.
    if root.is-signed-in && root.deleting-message-index >= 0
            && root.messages[root.deleting-message-index].can-delete: DeleteMessageDialog {
        width: root.width;
        height: root.height;
        message: root.messages[root.deleting-message-index];
        cancel => {
            root.deleting-message-index = -1;
            chat.focus-composer();
        }
        confirm => {
            root.delete-message(root.deleting-message-index);
            root.deleting-message-index = -1;
            chat.focus-composer();
        }
    }

    if root.is-signed-in && root.open-dialog == ShellDialog.add-server: AddServerDialog {
        width: root.width;
        height: root.height;
        is-busy: root.is-dialog-busy;
        error-message: root.dialog-error;
        create-server(name) => { root.create-server(name); }
        join-server(code) => { root.join-server(code); }
        close => { root.close-dialog(); }
    }

    if root.is-signed-in && root.open-dialog == ShellDialog.invite-people: InvitePeopleDialog {
        width: root.width;
        height: root.height;
        server-name: root.server-name;
        invite-code: root.invite-code;
        error-message: root.dialog-error;
        copy-invite-code => { root.copy-invite-code(); }
        close => { root.close-dialog(); }
    }

    if root.is-signed-in && root.open-dialog == ShellDialog.create-channel: CreateChannelDialog {
        width: root.width;
        height: root.height;
        category-name: root.create-channel-category-name;
        is-busy: root.is-dialog-busy;
        error-message: root.dialog-error;
        create-channel(name) => { root.create-channel(name); }
        close => { root.close-dialog(); }
    }

    if root.is-signed-in && root.open-dialog == ShellDialog.leave-server: LeaveServerDialog {
        width: root.width;
        height: root.height;
        server-name: root.server-name;
        is-busy: root.is-dialog-busy;
        error-message: root.dialog-error;
        leave-server => { root.leave-server(); }
        close => { root.close-dialog(); }
    }

    if root.is-signed-in && root.is-quick-switcher-open: QuickSwitcher {
        width: root.width;
        height: root.height;
        rows: root.quick-switcher-rows;
        query-changed(query) => { root.quick-switcher-query-changed(query); }
        chosen(index) => {
            root.is-quick-switcher-open = false;
            root.quick-switcher-chosen(index);
            chat.focus-composer();
        }
        close => {
            root.is-quick-switcher-open = false;
            chat.focus-composer();
        }
    }

    if root.is-signed-in && root.is-user-settings-open: UserSettingsScreen {
        width: root.width;
        height: root.height;
        is-narrow: !root.is-wide-enough-for-sidebar;
        theme-choice <=> root.theme-choice;
        appearance-changed => { root.appearance-changed(); }
        app-version: root.app-version;
        update-status: root.update-status;
        available-version: root.available-version;
        update-error-text: root.update-error-text;
        close => { root.close-user-settings(); }
        sign-out => {
            root.is-user-settings-open = false;
            root.sign-out();
        }
        check-for-updates => { root.check-for-updates(); }
        install-update => { root.install-update(); }
        restart-to-update => { root.restart-to-update(); }
        account-display-name: root.account-display-name;
        account-username: root.account-username;
        account-email: root.account-email;
        is-account-busy: root.is-account-busy;
        account-error: root.account-error;
        account-notice: root.account-notice;
        account-saved-count: root.account-saved-count;
        save-display-name(display-name) => { root.save-display-name(display-name); }
        save-username(username, current-password) => { root.save-username(username, current-password); }
        change-password(current-password, new-password) => { root.change-password(current-password, new-password); }
    }

    if root.is-signed-in && root.is-server-settings-open: ServerSettingsScreen {
        width: root.width;
        height: root.height;
        is-narrow: !root.is-wide-enough-for-sidebar;
        server-name: root.server-name;
        roles: root.server-settings-roles;
        selected-role-index: root.selected-role-index;
        role-draft-name <=> root.role-draft-name;
        role-draft-color: root.role-draft-color;
        role-draft-has-color: root.role-draft-has-color;
        role-color-presets: root.role-color-presets;
        permission-rows: root.role-permission-rows;
        is-role-draft-editable: root.is-role-draft-editable;
        has-unsaved-role-changes: root.has-unsaved-role-changes;
        is-role-action-busy: root.is-role-action-busy;
        role-action-error: root.role-action-error;
        can-create-roles: root.can-create-roles;
        close => { root.leave-server-settings(); }
        select-role(index) => { root.select-role(index); }
        role-draft-name-edited => { root.role-draft-name-edited(); }
        choose-role-color(index) => { root.choose-role-color(index); }
        toggle-role-permission(index) => { root.toggle-role-permission(index); }
        save-role-changes => { root.save-role-changes(); }
        reset-role-changes => { root.reset-role-changes(); }
        create-role => { root.create-role(); }
        delete-role(index) => { root.delete-role(index); }
        move-role-up(index) => { root.move-role-up(index); }
        move-role-down(index) => { root.move-role-down(index); }
    }
}
