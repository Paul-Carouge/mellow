import { MellowColor, MellowSize, MellowTheme, MellowType } from "tokens.slint";
// Bundled into the binary so every platform renders the same typeface (DESIGN.md §2.4).
import "../fonts/Figtree[wght].ttf";
import "../fonts/Figtree-Italic[wght].ttf";
import { ServerRail, ServerItem } from "components/server_rail.slint";
import { ChannelSidebar, ChannelListRow } from "components/channel_sidebar.slint";
import { ChatPane, HistoryStartState, MessageDelivery, MessageRow } from "components/chat_pane.slint";
import { MemberList, MemberListRow } from "components/member_list.slint";
import { PresenceStatus } from "components/primitives.slint";
import { LoginScreen } from "components/login_screen.slint";
import { ConnectionBanner } from "components/connection_banner.slint";
import { DeleteMessageDialog } from "components/delete_message_dialog.slint";

export { ServerItem, ChannelListRow, HistoryStartState, MessageDelivery, MessageRow, MemberListRow, PresenceStatus, MellowTheme }

// Window width breakpoints from DESIGN.md §4.2: each one is the sum of the panes it must fit.
global LayoutBreakpoint {
    out property <length> sidebar-visible: MellowSize.rail-width + MellowSize.sidebar-width + MellowSize.chat-min-width;
    out property <length> all-panes: MellowSize.rail-width + MellowSize.sidebar-width + MellowSize.chat-min-width + MellowSize.member-list-width;
}

export component AppWindow inherits Window {
    in property <[ServerItem]> servers;
    in-out property <int> selected-server-index;
    in property <string> server-name;
    in property <[ChannelListRow]> channel-rows;
    in property <string> selected-channel-id;
    in property <string> selected-channel-name;
    in property <string> selected-channel-topic;
    in property <[MessageRow]> messages;
    in property <[MemberListRow]> member-rows;
    in property <string> current-user-name;
    in property <string> current-user-initial;
    in property <string> latest-announcement;
    in-out property <string> composer-text;
    in-out property <bool> is-text-selection-mode;
    in-out property <bool> is-member-list-visible: true;
    in property <bool> is-signed-in;
    // Empty hides the banner.
    in property <string> connection-notice;
    in-out property <string> login-instance-address;
    in-out property <string> login-login;
    in-out property <string> login-username;
    in-out property <string> login-email;
    in-out property <string> login-password;
    in-out property <bool> login-is-registering;
    in property <bool> login-is-busy;
    in property <string> login-error-message;
    // Message actions (DESIGN.md §5.4, §5.5); see ChatPane for each one's meaning.
    in property <string> replying-to-author;
    in-out property <int> editing-message-index: -1;
    in-out property <string> editing-message-draft;
    in-out property <int> deleting-message-index: -1;
    in property <string> message-action-error;

    // Set from `changed width` rather than bound to `width`: a binding would make the layout depend
    // on itself (the panes' presence changes the window's minimum width).
    property <bool> is-wide-enough-for-member-list: true;
    property <bool> is-wide-enough-for-sidebar: true;
    changed width => {
        self.is-wide-enough-for-member-list = self.width >= LayoutBreakpoint.all-panes;
        self.is-wide-enough-for-sidebar = self.width >= LayoutBreakpoint.sidebar-visible;
    }

    callback select-server(int);
    callback select-channel(string);
    callback toggle-category(int);
    callback send-message(string);
    callback link-clicked(string);
    callback copy-message-text(int);
    callback reply-to-message(int);
    callback cancel-reply();
    callback save-message-edit(int, string);
    callback edit-last-own-message();
    callback delete-message(int);
    callback retry-message(int);
    callback discard-failed-message(int);
    callback load-older-messages();
    in property <HistoryStartState> history-start-state;
    callback retry-loading-history();
    callback sign-in();
    callback register();
    callback sign-out();

    public function scroll-to-latest-message() {
        chat.scroll-to-latest-message();
    }
    public function keep-distance-from-latest-message() {
        chat.keep-distance-from-latest-message();
    }
    public function scroll-up-by(distance: length) -> bool {
        chat.scroll-up-by(distance)
    }

    title: "Mellow";
    preferred-width: MellowSize.window-default-width;
    preferred-height: MellowSize.window-default-height;
    min-width: MellowSize.window-min-width;
    min-height: MellowSize.window-min-height;
    background: MellowColor.surface-chat;
    default-font-family: MellowType.message.font-family;

    forward-focus: key-handler;
    // Typing goes to the composer on launch, as on Discord.
    init => {
        if root.is-signed-in {
            chat.focus-composer();
        }
    }
    // The shell exists from the start (hidden), so its init focus has to be redone once it shows.
    changed is-signed-in => {
        if root.is-signed-in {
            chat.focus-composer();
        }
    }

    // Key events bubble up from the focused child to this scope, so shortcuts work anywhere.
    key-handler := FocusScope {
        // Hidden rather than removed while signed out, so `chat` stays addressable; hidden items
        // are skipped by Tab and left out of the accessibility tree.
        visible: root.is-signed-in;
        key-pressed(event) => {
            if event.text == Key.F2 {
                root.is-text-selection-mode = !root.is-text-selection-mode;
                return accept;
            }
            reject
        }

        VerticalLayout {
        ConnectionBanner {
            text: root.connection-notice;
        }
        HorizontalLayout {
            // shortcut: below 792 px the rail and sidebar are hidden; the drawer (DESIGN.md §4.2) comes later.
            if root.is-wide-enough-for-sidebar: ServerRail {
                servers: root.servers;
                selected-server-index: root.selected-server-index;
                select-server(index) => { root.select-server(index); }
            }
            if root.is-wide-enough-for-sidebar: ChannelSidebar {
                server-name: root.server-name;
                rows: root.channel-rows;
                selected-channel-id: root.selected-channel-id;
                current-user-name: root.current-user-name;
                current-user-initial: root.current-user-initial;
                toggle-category(index) => { root.toggle-category(index); }
                select-channel(name) => { root.select-channel(name); }
                sign-out => { root.sign-out(); }
            }
            chat := ChatPane {
                horizontal-stretch: 1;
                channel-name: root.selected-channel-name;
                channel-topic: root.selected-channel-topic;
                messages: root.messages;
                is-text-selection-mode: root.is-text-selection-mode;
                latest-announcement: root.latest-announcement;
                composer-text <=> root.composer-text;
                is-member-list-visible <=> root.is-member-list-visible;
                send-message(text) => { root.send-message(text); }
                link-clicked(url) => { root.link-clicked(url); }
                copy-message-text(index) => { root.copy-message-text(index); }
                replying-to-author: root.replying-to-author;
                editing-message-index <=> root.editing-message-index;
                editing-message-draft <=> root.editing-message-draft;
                deleting-message-index <=> root.deleting-message-index;
                message-action-error: root.message-action-error;
                reply-to-message(index) => { root.reply-to-message(index); }
                cancel-reply => { root.cancel-reply(); }
                save-message-edit(index, text) => { root.save-message-edit(index, text); }
                edit-last-own-message => { root.edit-last-own-message(); }
                delete-message(index) => { root.delete-message(index); }
                retry-message(index) => { root.retry-message(index); }
                discard-failed-message(index) => { root.discard-failed-message(index); }
                load-older-messages => { root.load-older-messages(); }
                history-start-state: root.history-start-state;
                retry-loading-history => { root.retry-loading-history(); }
            }
            // shortcut: below 1032 px the member list is hidden instead of becoming an overlay.
            if root.is-member-list-visible && root.is-wide-enough-for-member-list: MemberList {
                rows: root.member-rows;
            }
        }
        }
    }

    if !root.is-signed-in: LoginScreen {
        width: root.width;
        height: root.height;
        instance-address <=> root.login-instance-address;
        login <=> root.login-login;
        username <=> root.login-username;
        email <=> root.login-email;
        password <=> root.login-password;
        is-registering <=> root.login-is-registering;
        is-busy: root.login-is-busy;
        error-message: root.login-error-message;
        sign-in => { root.sign-in(); }
        register => { root.register(); }
    }

    // Window-wide so its scrim covers every pane, as Discord's dialogs do. Focus returns to the
    // composer on close: the hover bar's Delete button that opened it is gone by then.
    if root.is-signed-in && root.deleting-message-index >= 0: DeleteMessageDialog {
        width: root.width;
        height: root.height;
        message: root.messages[root.deleting-message-index];
        cancel => {
            root.deleting-message-index = -1;
            chat.focus-composer();
        }
        confirm => {
            root.delete-message(root.deleting-message-index);
            root.deleting-message-index = -1;
            chat.focus-composer();
        }
    }
}
